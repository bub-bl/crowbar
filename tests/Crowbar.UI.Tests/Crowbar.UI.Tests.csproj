<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The IL fast path patches JIT code in place; tiered compilation would
         replace it with a promoted body, so tests disable tiering (same
         runtimeconfig as the editor). -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UI\Crowbar.UI.csproj" />
    <ProjectReference Include="..\..\src\Engine\Engine.csproj" />
    <ProjectReference Include="..\..\src\FileSystem\Crowbar.FileSystem.csproj" />
  </ItemGroup>
</Project>

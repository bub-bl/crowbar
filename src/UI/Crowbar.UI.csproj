<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Crowbar.UI</AssemblyName>
    <RootNamespace>Crowbar.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Yoga.Net" Version="3.2.3" />
    <!-- Text measurement (layout) and image dimension lookup share the same
         libraries as the GPU renderer so measured boxes match painted glyphs. -->
    <PackageReference Include="SixLabors.Fonts" Version="3.1.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="Microsoft.AspNetCore.Razor.Language" Version="6.0.36" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <!-- Provides the Razor/Blazor component surface (IComponent, Parameter,
       RenderFragment) used by the runtime component compiler. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Crowbar.UI.Tests" />
  </ItemGroup>
</Project>

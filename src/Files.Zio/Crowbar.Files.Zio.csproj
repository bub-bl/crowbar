<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Crowbar.Files.Zio</AssemblyName>
    <RootNamespace>Crowbar.Files.Zio</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Files\Crowbar.Files.csproj" />
    <!-- Zio is an implementation detail of this adapter. The compile asset is
         private, so no consumer can write `using Zio`; only the runtime asset
         flows transitively so Zio.dll is deployed next to this assembly. -->
    <PackageReference Include="Zio" Version="0.24.0" PrivateAssets="compile;contentfiles;analyzers;build" />
  </ItemGroup>
</Project>

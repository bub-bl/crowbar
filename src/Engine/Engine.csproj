<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Crowbar.Engine</AssemblyName>
    <RootNamespace>Crowbar.Engine</RootNamespace>
    <AllowUnsafeBlock>true</AllowUnsafeBlock>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Crowbar.UI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Engine built-ins only: the demo models and sounds live in the game
         project's Content/ folder (Game/Content), mounted at /Content. -->
    <None Include="..\..\Assets\Gizmos\**\*.svg" Link="Assets\Gizmos\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Assets\Icons\**\*.svg" Link="Assets\Icons\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="SixLabors.Fonts" Version="3.1.0" />
    <PackageReference Include="Silk.NET.SDL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.WebGPU" Version="2.23.0" />
    <PackageReference Include="Silk.NET.WebGPU.Extensions.WGPU" Version="2.23.0" />
    <PackageReference Include="Silk.NET.WebGPU.Native.WGPU" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Assimp" Version="2.23.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <!-- Audio decoding: Ogg/Vorbis (NVorbis) and MP3 (NLayer), both MIT and fully managed. -->
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="NLayer" Version="2.0.1" />
    <!-- In-memory compilation of game scripts (ScriptCompiler / ScriptHost). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileSystem\Crowbar.FileSystem.csproj" />
    <ProjectReference Include="..\UI\Crowbar.UI.csproj" />
  </ItemGroup>

  <!-- Slang shader pipeline: author in Shaders/**/*.slang (Common/ holds the
       imported modules), compile to WGSL (plus a
       reflection JSON sidecar) with the vendored slangc, and ship only the
       compiled artifacts. The .slang source is the single source of truth; the
       engine loads the emitted WGSL + JSON at runtime. -->
  <PropertyGroup>
    <_CrowbarRepoRoot>$(MSBuildThisFileDirectory)..\..\</_CrowbarRepoRoot>
    <_CrowbarSlangc>$(_CrowbarRepoRoot)tools\slang\slangc.exe</_CrowbarSlangc>
  </PropertyGroup>

  <ItemGroup>
    <SlangShader Include="$(_CrowbarRepoRoot)Shaders\**\*.slang" Exclude="$(_CrowbarRepoRoot)Shaders\Common\**\*.slang" />
    <SlangShaderDependency Include="$(_CrowbarRepoRoot)Shaders\Common\**\*.slang" />
  </ItemGroup>

  <!-- Remove WGSL/sidecar artifacts whose .slang source was renamed or
       deleted, so dead shaders never linger in the compile intermediates or
       the shipped output. -->
  <Target Name="CrowbarPurgeOrphanedSlangShaders"
          BeforeTargets="CrowbarCompileSlangShaders"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_CrowbarSlangOnDisk Include="$(IntermediateOutputPath)SlangShaders\**\*.wgsl" />
      <_CrowbarSlangOnDisk Include="$(IntermediateOutputPath)SlangShaders\**\*.slang.json" />
      <_CrowbarSlangOnDisk Include="$(TargetDir)Shaders\**\*.wgsl" Condition="'$(TargetDir)' != ''" />
      <_CrowbarSlangOnDisk Include="$(TargetDir)Shaders\**\*.slang.json" Condition="'$(TargetDir)' != ''" />
      <_CrowbarSlangExpected Include="@(SlangShader->'$(IntermediateOutputPath)SlangShaders\%(RecursiveDir)%(Filename).wgsl')" />
      <_CrowbarSlangExpected Include="@(SlangShader->'$(IntermediateOutputPath)SlangShaders\%(RecursiveDir)%(Filename).slang.json')" />
      <_CrowbarSlangExpected Include="@(SlangShader->'$(TargetDir)Shaders\%(RecursiveDir)%(Filename).wgsl')" Condition="'$(TargetDir)' != ''" />
      <_CrowbarSlangExpected Include="@(SlangShader->'$(TargetDir)Shaders\%(RecursiveDir)%(Filename).slang.json')" Condition="'$(TargetDir)' != ''" />
      <_CrowbarSlangOnDisk Remove="@(_CrowbarSlangExpected)" />
    </ItemGroup>
    <Message Importance="high"
             Condition="'@(_CrowbarSlangOnDisk)' != ''"
             Text="[Slang] Purging orphaned shader artifacts: @(_CrowbarSlangOnDisk)" />
    <Delete Files="@(_CrowbarSlangOnDisk)" />
  </Target>

  <!-- Incremental: slangc runs only when a .slang source is newer than its
       compiled WGSL (or the sidecar is missing). IntermediateOutputPath is
       referenced inside the targets (not a top-level PropertyGroup) so it
       resolves with the target-framework suffix applied. -->
  <Target Name="CrowbarCompileSlangShaders"
          Inputs="@(SlangShader);@(SlangShaderDependency)"
          Outputs="@(SlangShader->'$(IntermediateOutputPath)SlangShaders\%(RecursiveDir)%(Filename).wgsl');@(SlangShader->'$(IntermediateOutputPath)SlangShaders\%(RecursiveDir)%(Filename).slang.json')">
    <MakeDir Directories="$(IntermediateOutputPath)SlangShaders\%(SlangShader.RecursiveDir)" />
    <Exec Command="&quot;$(_CrowbarSlangc)&quot; &quot;%(SlangShader.FullPath)&quot; -target wgsl -I &quot;$(_CrowbarRepoRoot)Shaders\Common&quot; -o &quot;$(IntermediateOutputPath)SlangShaders\%(SlangShader.RecursiveDir)%(SlangShader.Filename).wgsl&quot; -reflection-json &quot;$(IntermediateOutputPath)SlangShaders\%(SlangShader.RecursiveDir)%(SlangShader.Filename).slang.json&quot;" />
  </Target>

  <!-- Collect the compiled artifacts into the output (always runs, so the
       files are also copied on incremental builds where slangc was skipped). -->
  <Target Name="CrowbarCollectSlangShaders"
          BeforeTargets="PrepareForBuild"
          DependsOnTargets="CrowbarCompileSlangShaders"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <SlangShaderOutput Include="$(IntermediateOutputPath)SlangShaders\**\*.wgsl" />
      <SlangShaderOutput Include="$(IntermediateOutputPath)SlangShaders\**\*.slang.json" />
    </ItemGroup>
    <ItemGroup>
      <None Include="@(SlangShaderOutput)">
        <Link>Shaders\%(SlangShaderOutput.RecursiveDir)%(SlangShaderOutput.Filename)%(SlangShaderOutput.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>
  </Target>
</Project>

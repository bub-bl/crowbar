<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Crowbar.Editor</AssemblyName>
    <RootNamespace>Crowbar.Editor</RootNamespace>
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
    <UseRazorSourceGenerator>false</UseRazorSourceGenerator>
    <EnableDefaultRazorComponentItems>false</EnableDefaultRazorComponentItems>
    <RazorLangVersion>Latest</RazorLangVersion>
    <ScopedCssEnabled>false</ScopedCssEnabled>

    <!-- SCSS → CSS à la compilation (DartSassBuilder). Lisible en Debug, minifié en Release. -->
    <DartSassOutputStyle>compressed</DartSassOutputStyle>
    <DartSassOutputStyle Condition="'$(Configuration)' == 'Debug'">expanded</DartSassOutputStyle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engine\Engine.csproj" />
    <Content Update="Ui\**\*.razor" CopyToOutputDirectory="PreserveNewest" />
    <!-- Images referenced by the SCSS/CSS url() resolve against the app base
         directory, so they must land next to the compiled .razor files. -->
    <Content Include="Ui\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Compile SCSS to CSS with dart-sass on build. DartSassBuilder scans
       **/*.scss automatically (partials starting with '_' are excluded). -->
  <ItemGroup>
    <PackageReference Include="DartSassBuilder" Version="1.1.0" />
  </ItemGroup>

  <!-- The runtime falls back to the output directory when the Ui sources are
       not present (published/standalone builds), so the CSS generated by
       DartSassBuilder must be copied next to the compiled .razor files. -->
  <Target Name="CrowbarCopySassOutput"
          AfterTargets="DartSass_Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_CrowbarGeneratedCss Include="Ui\**\*.css" />
    </ItemGroup>
    <Copy SourceFiles="@(_CrowbarGeneratedCss)"
          DestinationFiles="@(_CrowbarGeneratedCss->'$(OutDir)Ui\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Provides the standard Razor component reference surface to the IDE.
       The runtime compiler remains custom and does not use ASP.NET rendering. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

    <!--
      Keep the custom runtime compiler authoritative during normal builds. The
      Razor SDK still receives the files during design-time builds, which gives
      IDEs a generated declaration/context for completion and diagnostics.
    -->
  <ItemGroup>
    <RazorComponent Include="Ui\**\*.razor" />
  </ItemGroup>

  <!-- The IDE keeps the RazorComponent item for language services. During a
       normal build remove it before the Razor SDK resolves its inputs; the
       runtime RazorComponentFactory remains the actual compiler. -->
  <Target Name="CrowbarDisableRazorBuildItems"
          BeforeTargets="ResolveRazorComponentInputs"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <RazorComponent Remove="Ui\**\*.razor" />
    </ItemGroup>
  </Target>
</Project>

@inherits Crowbar.UI.RazorPanel
@namespace Crowbar.Editor.Ui
@using Crowbar.UI
@using Crowbar.UI.Docking

@* Résout les rects des groupes et les poignées de split à partir de l'état
   courant de l'arbre de docking et de la taille de la zone (le Layout du
   composant, mis à jour au pass de layout précédent). *@
@{
    ComputeLayout();
}

<div class="dock-area" @onmousemove="OnPointerMove" @onmouseup="OnPointerUp">
    @foreach (var group in _tree.Groups())
    {
        if (_rects.TryGetValue(group.Id, out var rect) && rect.Width > 0 && rect.Height > 0)
        {
            var active = group.ActiveTab;
            <div class="dock-group" data-dock-id="@group.Id"
                 style="left:@Px(rect.X); top:@Px(rect.Y); width:@Px(rect.Width); height:@Px(rect.Height);">
                <div class="dock-tabbar">
                    @foreach (var tab in group.Tabs)
                    {
                        <div class="dock-tab @(tab == active ? "dock-tab-active" : "")"
                             data-dock-item="@tab" @onmousedown="BeginTabDrag">@Title(tab)</div>
                    }
                </div>
                <div class="dock-content">
                    @* Chaque onglet garde son panneau monté (les inactifs sont
                       juste masqués) : les composants conservent leur état quand
                       on change d'onglet. @key fige l'instance du composant sur
                       son id, donc un panneau déplacé vers un autre groupe par
                       drag & drop garde aussi son état. *@
                    @foreach (var tab in group.Tabs)
                    {
                        var visible = tab == active;
                        <div class="dock-pane @(visible ? "dock-pane-active" : "dock-pane-hidden")">
                            @if (tab == "outils")
                            {
                                <ToolsPanel @key="outils" />
                            }
                            else if (tab == "explorer")
                            {
                                <ExplorerPanel @key="explorer" />
                            }
                            else if (tab == "viewport")
                            {
                                <ViewportPanel @key="viewport" />
                            }
                            else if (tab == "inspector")
                            {
                                <InspectorPanel @key="inspector" />
                            }
                            else if (tab == "world")
                            {
                                <WorldPanel @key="world" />
                            }
                            else if (tab == "content")
                            {
                                <ContentPanel @key="content" />
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }

    @* Poignées de redimensionnement sur les coutures entre les groupes. *@
    @foreach (var splitter in _splitters)
    {
        <div class="dock-splitter @(splitter.Horizontal ? "dock-splitter-h" : "dock-splitter-v")"
             data-dock-split="@splitter.SplitId" data-dock-index="@splitter.Index"
             style="left:@Px(splitter.Rect.X); top:@Px(splitter.Rect.Y); width:@Px(splitter.Rect.Width); height:@Px(splitter.Rect.Height);"
             @onmousedown="BeginSplitterDrag"></div>
    }

    @if (_drag is not null)
    {
        var ghostX = _drag.X - _areaRect.X + 10;
        var ghostY = _drag.Y - _areaRect.Y + 14;
        <div class="dock-ghost" style="left:@Px(ghostX); top:@Px(ghostY);">@Title(_drag.ItemId)</div>
        if (_preview is { } preview)
        {
            var previewRect = PreviewRect(preview.GroupId, preview.Zone);
            <div class="dock-preview @PreviewClass(preview.Zone)"
                 style="left:@Px(previewRect.X); top:@Px(previewRect.Y); width:@Px(previewRect.Width); height:@Px(previewRect.Height);"></div>
        }
    }
</div>

@code {
    private readonly DockTree _tree = CreateInitialTree();
    private readonly Dictionary<string, UiRect> _rects = new(StringComparer.Ordinal);
    private readonly List<DockSplitter> _splitters = new();
    private UiRect _areaRect;
    private DragState? _drag;
    private PreviewState? _preview;
    private SplitterDragState? _splitDrag;
    private bool _initialLayoutRefreshRequested;

    private sealed class DragState
    {
        public DragState(string itemId, float x, float y)
        {
            ItemId = itemId;
            StartX = x;
            StartY = y;
            X = x;
            Y = y;
        }

        public string ItemId { get; }
        public float StartX { get; }
        public float StartY { get; }
        public float X { get; set; }
        public float Y { get; set; }
    }

    private readonly record struct PreviewState(string GroupId, DockZone Zone);

    private sealed class SplitterDragState
    {
        public SplitterDragState(string splitId, int index, float x, float y)
        {
            SplitId = splitId;
            Index = index;
            StartX = x;
            StartY = y;
        }

        public string SplitId { get; }
        public int Index { get; }
        public float StartX { get; }
        public float StartY { get; }
    }

    protected override void OnTreeBuilt()
    {
        if (_initialLayoutRefreshRequested) return;
        _initialLayoutRefreshRequested = true;
        StateHasChanged();
    }

    /// <summary>Disposition initiale : outils / explorateur / (viewport + bas) / inspecteur.</summary>
    private static DockTree CreateInitialTree()
    {
        var outils = new DockGroupNode("outils");
        outils.Tabs.Add("outils");
        var explorer = new DockGroupNode("explorer");
        explorer.Tabs.Add("explorer");
        var viewport = new DockGroupNode("viewport");
        viewport.Tabs.Add("viewport");
        var bottom = new DockGroupNode("bottom");
        bottom.Tabs.Add("world");
        bottom.Tabs.Add("content");
        var inspector = new DockGroupNode("inspector");
        inspector.Tabs.Add("inspector");

        var center = new DockSplitNode(horizontal: false);
        center.Children.Add(viewport);
        center.Weights.Add(0f); // flexible : prend tout l'espace restant
        center.Children.Add(bottom);
        center.Weights.Add(232f); // bande inférieure fixe

        var root = new DockSplitNode(horizontal: true);
        root.Children.Add(outils);
        root.Weights.Add(100f);
        root.Children.Add(explorer);
        root.Weights.Add(230f);
        root.Children.Add(center);
        root.Weights.Add(0f); // flexible
        root.Children.Add(inspector);
        root.Weights.Add(280f);
        return new DockTree(root);
    }

    private static string Px(float value) => FormattableString.Invariant($"{value:0.###}px");

    private string Title(string itemId) => itemId switch
    {
        "outils" => "OUTILS",
        "explorer" => "EXPLORATEUR",
        "viewport" => "VIEWPORT",
        "inspector" => "INSPECTEUR",
        "world" => "MONDE",
        "content" => "CONTENU",
        _ => itemId
    };

    private void ComputeLayout()
    {
        _areaRect = Layout;
        if (_areaRect.Width <= 0 || _areaRect.Height <= 0)
        {
            _rects.Clear();
            _splitters.Clear();
            return;
        }

        // Rects locaux (origine 0,0 = coin supérieur gauche de la zone).
        var area = new UiRect(0, 0, _areaRect.Width, _areaRect.Height);
        _tree.ComputeRects(area, _rects);
        _tree.ComputeSplitters(area, _splitters);
    }

    // ---- Drag d'un onglet -------------------------------------------------

    private bool BeginTabDrag(UiPointerEvent e)
    {
        if (e.Button != 0) return false;
        var item = HitTestTab(e.X, e.Y);
        if (item is null) return false;
        var group = _tree.GroupOf(item);
        if (group is not null) group.Active = group.Tabs.IndexOf(item);
        ComputeLayout();
        _drag = new DragState(item, e.X, e.Y);
        _preview = null;
        return true;
    }

    private bool OnPointerMove(UiPointerEvent e)
    {
        if (_splitDrag is not null)
        {
            UpdateSplitterDrag(e);
            return true;
        }

        if (_drag is null) return false;
        _drag.X = e.X;
        _drag.Y = e.Y;
        _preview = ComputeTarget(e.X, e.Y);
        return true;
    }

    private bool OnPointerUp(UiPointerEvent e)
    {
        if (_splitDrag is not null)
        {
            _splitDrag = null;
            return true;
        }

        if (_drag is null) return false;
        var dx = e.X - _drag.StartX;
        var dy = e.Y - _drag.StartY;
        var moved = MathF.Sqrt(dx * dx + dy * dy);
        // Resolve the release position again instead of committing the last
        // hover preview. Pointer capture can deliver mouse-up after the cursor
        // left the dock area; in that case the drag is cancelled, not dropped
        // onto a stale target.
        var drop = ComputeTarget(e.X, e.Y);
        if (moved >= 4f && drop is { } preview)
            ApplyDock(_drag.ItemId, preview.GroupId, preview.Zone);
        _drag = null;
        _preview = null;
        return true;
    }

    private PreviewState? ComputeTarget(float x, float y)
    {
        var localX = x - _areaRect.X;
        var localY = y - _areaRect.Y;
        if (localX < 0 || localY < 0 || localX > _areaRect.Width || localY > _areaRect.Height) return null;
        foreach (var (id, rect) in _rects)
        {
            if (localX < rect.X || localX > rect.Right || localY < rect.Y || localY > rect.Bottom) continue;
            var relX = (localX - rect.X) / Math.Max(1f, rect.Width);
            var relY = (localY - rect.Y) / Math.Max(1f, rect.Height);
            var zone = relX < DockTree.EdgeZoneFraction
                ? DockZone.Left
                : relX > 1f - DockTree.EdgeZoneFraction
                    ? DockZone.Right
                    : relY < DockTree.EdgeZoneFraction
                        ? DockZone.Top
                        : relY > 1f - DockTree.EdgeZoneFraction
                            ? DockZone.Bottom
                            : DockZone.Center;
            return new PreviewState(id, zone);
        }

        return null;
    }

    private void ApplyDock(string itemId, string groupId, DockZone zone)
    {
        if (zone == DockZone.Center) _tree.DockToTab(itemId, groupId);
        else _tree.DockToSplit(itemId, groupId, zone);

        // A stale preview can refer to a group that disappeared during a
        // reconciliation pass. Never let that turn into a missing panel: the
        // dragged item is always parked back into the layout as a last resort.
        if (_tree.GroupOf(itemId) is null)
            _tree.ParkAtRoot(itemId);
    }

    private UiRect PreviewRect(string groupId, DockZone zone)
    {
        if (!_rects.TryGetValue(groupId, out var rect)) return new UiRect(0, 0, 0, 0);
        const float inset = 3f;
        var band = zone is DockZone.Left or DockZone.Right
            ? Math.Max(24f, rect.Width * 0.32f)
            : Math.Max(24f, rect.Height * 0.32f);
        return zone switch
        {
            DockZone.Center => new UiRect(rect.X + inset, rect.Y + inset, rect.Width - 2 * inset, rect.Height - 2 * inset),
            DockZone.Left => new UiRect(rect.X + inset, rect.Y + inset, band, rect.Height - 2 * inset),
            DockZone.Right => new UiRect(rect.Right - band - inset, rect.Y + inset, band, rect.Height - 2 * inset),
            DockZone.Top => new UiRect(rect.X + inset, rect.Y + inset, rect.Width - 2 * inset, band),
            _ => new UiRect(rect.X + inset, rect.Bottom - band - inset, rect.Width - 2 * inset, band)
        };
    }

    private static string PreviewClass(DockZone zone) => "dock-preview-" + zone.ToString().ToLowerInvariant();

    // ---- Redimensionnement des groupes -----------------------------------

    private bool BeginSplitterDrag(UiPointerEvent e)
    {
        if (e.Button != 0) return false;
        var splitter = HitTestSplitter(e.X, e.Y);
        if (splitter is null) return false;
        _splitDrag = new SplitterDragState(splitter.Value.SplitId, splitter.Value.Index, e.X, e.Y);
        return true;
    }

    private void UpdateSplitterDrag(UiPointerEvent e)
    {
        var drag = _splitDrag;
        if (drag is null) return;
        var split = _tree.Splits().FirstOrDefault(s => s.Id == drag.SplitId);
        if (split is null || drag.Index + 1 >= split.Children.Count)
        {
            _splitDrag = null;
            StateHasChanged();
            return;
        }

        var rects = _tree.SplitChildRects(split, new UiRect(0, 0, Layout.Width, Layout.Height));
        if (drag.Index + 1 >= rects.Count)
        {
            _splitDrag = null;
            StateHasChanged();
            return;
        }

        var a = rects[drag.Index];
        var b = rects[drag.Index + 1];
        var total = split.Horizontal ? a.Width + b.Width : a.Height + b.Height;
        if (total <= 0)
        {
            _splitDrag = null;
            StateHasChanged();
            return;
        }

        var aSize = split.Horizontal ? a.Width : a.Height;
        var delta = split.Horizontal ? e.X - drag.StartX : e.Y - drag.StartY;
        var fraction = Math.Clamp((aSize + delta) / total, 0.15f, 0.85f);
        split.Weights[drag.Index] = fraction * total;
        split.Weights[drag.Index + 1] = (1f - fraction) * total;
        StateHasChanged();
    }

    // ---- Hit-test sur l'arbre de panneaux vivant ---------------------------

    /// <summary>
    /// Retrouve l'onglet sous le curseur en hit-testant l'arbre de panneaux
    /// actuellement monté (les rects de Layout y sont à jour jusqu'au prochain
    /// rendu), puis en remontant jusqu'à un élément de classe <c>dock-tab</c>.
    /// </summary>
    private string? HitTestTab(float x, float y)
    {
        var hit = HitTestPanel(this, x, y);
        for (var p = hit; p is not null; p = p.Parent)
        {
            if (p.Classes.Contains("dock-tab") && p.Attributes.TryGetValue("data-dock-item", out var item))
                return item;
        }

        return null;
    }

    private (string SplitId, int Index)? HitTestSplitter(float x, float y)
    {
        var hit = HitTestPanel(this, x, y);
        for (var p = hit; p is not null; p = p.Parent)
        {
            if (p.Classes.Contains("dock-splitter") &&
                p.Attributes.TryGetValue("data-dock-split", out var splitId) &&
                p.Attributes.TryGetValue("data-dock-index", out var index) &&
                int.TryParse(index, out var parsed))
            {
                return (splitId, parsed);
            }
        }

        return null;
    }

    /// <summary>Panneau le plus profond contenant le point (miroir simplifié du hit-test du runtime).</summary>
    private static Panel? HitTestPanel(Panel panel, float x, float y)
    {
        if (!panel.IsVisible) return null;
        var inside = x >= panel.Layout.X && x <= panel.Layout.Right &&
                     y >= panel.Layout.Y && y <= panel.Layout.Bottom;
        if (!inside) return null;
        var children = panel.Children;
        for (var i = children.Count - 1; i >= 0; i--)
        {
            var hit = HitTestPanel(children[i], x, y);
            if (hit is not null) return hit;
        }

        return panel;
    }
}

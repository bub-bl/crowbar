@inherits Crowbar.UI.RazorPanel
@namespace Crowbar.Editor.Ui.Components
@using Crowbar.UI
@using Microsoft.AspNetCore.Components
@using System.Globalization

<div class="prop-row">
    <div class="field-label">@Name</div>
    <input class="prop-input" value="@(_editing ? _draft : Value.ToString(CultureInfo.InvariantCulture))"
           @onfocus="BeginEdit"
           @oninput="OnInput"
           @onblur="Commit"
           @onkeydown="OnKeyDown" />
</div>

@code {
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public float Value { get; set; }

    private bool _editing;
    private string _draft = string.Empty;

    private void BeginEdit()
    {
        if (_editing) return;
        _editing = true;
        _draft = Value.ToString(CultureInfo.InvariantCulture);
    }

    private void OnInput(string value) { if (_editing) _draft = value; }

    private void Commit()
    {
        if (!_editing) return;
        _editing = false;
        EditorEnvironmentState.RequestEdit(Name, _draft);
        _draft = string.Empty;
    }

    private bool OnKeyDown(KeyEvent e)
    {
        if (e.IsDown && e.KeyCode == 13) { Commit(); return true; }
        return false;
    }

    protected override int BuildHash() => HashCode.Combine(Name, Value, _editing ? _draft : string.Empty);
}
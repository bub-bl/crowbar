@inherits Crowbar.UI.RazorPanel
@namespace Crowbar.Editor.Ui.Components
@using Crowbar.UI
@using Microsoft.AspNetCore.Components
@using System.Globalization

<div class="prop-row">
    <div class="field-label">@Name</div>
    <input class="prop-input" value="@Value.ToString(CultureInfo.InvariantCulture)" @onchange="Changed" />
</div>

@code {
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public float Value { get; set; }

    private void Changed(string value) => EditorEnvironmentState.RequestEdit(Name, value);
    protected override int BuildHash() => HashCode.Combine(Name, Value);
}

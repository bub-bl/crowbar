@inherits Crowbar.UI.RazorPanel
@namespace Crowbar.Editor.Ui.Components
@using Crowbar.UI
@using Microsoft.AspNetCore.Components
@using System.Globalization

<div class="prop-row">
    <div class="field-label">@Name</div>
    <ValueInput Value="@Value.ToString(CultureInfo.InvariantCulture)" Class="prop-input" OnCommit="Commit" />
</div>

@code {
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public float Value { get; set; }

    private void Commit(string text) => EditorEnvironmentState.RequestEdit(Name, text);

    protected override int BuildHash() => HashCode.Combine(Name, Value);
}
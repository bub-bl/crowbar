@inherits Crowbar.UI.RazorPanel
@namespace Crowbar.Editor.Ui.Components
@using Crowbar.UI

@if (EditorContentState.ContextMenu is { } menu)
{
    <div class="content-context-layer" @onmousedown="RepositionFromOutside" @onclick="CloseFromOutside">
        <div class="content-context-menu" @ref="_menuPanel" style="@ContextMenuStyle(menu)" @onmousedown="ConsumeContextPointer" @onclick="ConsumeContextClick">
        @if (menu.IsEmpty)
        {
            @if (_createKind is not null)
            {
                <div class="context-menu-title">New @CreateLabel</div>
                <input class="context-rename-input" value="@_createValue" @oninput="OnCreateInput" @onkeydown="OnCreateKeyDown" />
                <div class="context-menu-actions">
                    <div class="context-menu-item" @onclick="ConfirmCreate">Save</div>
                    <div class="context-menu-item" @onclick="CancelInlineAction">Cancel</div>
                </div>
            }
            else
            {
                <div class="context-menu-title">@ContextName(menu)</div>
                <div class="context-menu-item" @onclick="BeginCreateFolder">New Folder</div>
                <div class="context-menu-item" @onclick="BeginCreateFile">New File</div>
                <div class="context-menu-separator"></div>
                <div class="context-menu-item" @onclick="ImportPlaceholder">Import...</div>
                <div class="context-menu-item" @onclick="RefreshContent">Refresh</div>
            }
        }
        else if (_renamePath == menu.Path)
        {
            <div class="context-menu-title">Rename</div>
            <input class="context-rename-input" value="@_renameValue" @oninput="OnRenameInput" @onkeydown="OnRenameKeyDown" />
            <div class="context-menu-actions">
                <div class="context-menu-item" @onclick="ConfirmRename">Save</div>
                <div class="context-menu-item" @onclick="CancelInlineAction">Cancel</div>
            </div>
        }
        else if (_deletePath == menu.Path)
        {
            <div class="context-menu-title">Delete @ContextName(menu)</div>
            <div class="context-menu-warning">This cannot be undone.</div>
            <div class="context-menu-actions">
                <div class="context-menu-item context-menu-danger" @onclick="ConfirmDelete">Delete</div>
                <div class="context-menu-item" @onclick="CancelInlineAction">Cancel</div>
            </div>
        }
        else
        {
            <div class="context-menu-title">@ContextName(menu)</div>
            @if (menu.IsFolder)
            {
                <div class="context-menu-item" @onclick="OpenContextFolder">Open</div>
                <div class="context-menu-item" @onclick="BeginRename">Rename</div>
                <div class="context-menu-item" @onclick="BeginDelete">Delete</div>
            }
            else
            {
                <div class="context-menu-item" @onclick="OpenContextFile">Open</div>
                <div class="context-menu-item" @onclick="BeginRename">Rename</div>
                <div class="context-menu-item" @onclick="BeginDelete">Delete</div>
            }
            <div class="context-menu-item" @onclick="RevealContextPath">Reveal in Explorer</div>
        }
        </div>
    </div>
}

@code {
    private const float MenuWidth = 210f;
    private const float MenuHeight = 190f;

    private string? _renamePath;
    private string _renameValue = string.Empty;
    private string? _deletePath;
    // The empty-area menu's inline creation: "folder" or "file" while the
    // name input is shown, null in the plain menu state.
    private string? _createKind;
    private string _createValue = string.Empty;

    protected override int BuildHash() => HashCode.Combine(
        EditorContentState.Version, _renamePath, _renameValue, _deletePath, _createKind, _createValue);

    // The first open builds this component while the editor root is still
    // being rebuilt, before the component is attached to a laid-out parent, so
    // the position cannot be clamped to the real window in that first build.
    // _repositionRequested hides that one frame at the press position;
    // _repositionPending asks for the follow-up render (see OnTreeBuilt) whose
    // build has the parent geometry and clamps the menu into view.
    private bool _repositionRequested;
    private bool _repositionPending;

    private string ContextMenuStyle(EditorContentState.ContextMenuState menu)
    {
        var viewport = Parent?.Layout;
        if (viewport is not { Width: > 0, Height: > 0 })
        {
            // No geometry yet (first build): render hidden at the press
            // position and schedule one more render. If that render still
            // finds no geometry, fall back to a visible menu at the press
            // position instead of the old hard-coded 1920x1080 clamp, which
            // let the menu overflow smaller windows.
            if (!_repositionRequested)
            {
                _repositionRequested = true;
                _repositionPending = true;
                return $"left: {menu.X - 8:0}px; top: {menu.Y - 34:0}px; opacity: 0;";
            }
            return $"left: {menu.X - 8:0}px; top: {menu.Y - 34:0}px;";
        }
        _repositionRequested = false;
        var x = Math.Clamp(menu.X - viewport.Value.X - 8, 4, Math.Max(4, viewport.Value.Width - MenuWidth - 4));
        var y = Math.Clamp(menu.Y - viewport.Value.Y - 34, 4, Math.Max(4, viewport.Value.Height - MenuHeight - 4));
        return $"left: {x:0}px; top: {y:0}px;";
    }

    protected override void OnTreeBuilt()
    {
        // StateHasChanged called during the build would be undone by MarkBuilt
        // (it records the hash and clears StateDirty afterwards), so the
        // follow-up render that re-clamps the first open is requested here,
        // after the build completed.
        if (_repositionPending)
        {
            _repositionPending = false;
            StateHasChanged();
        }
    }

    private static string ContextName(EditorContentState.ContextMenuState menu)
    {
        var path = menu.Path.Trim('/');
        return path.Length == 0 ? "Content" : path.Split('/').Last();
    }

    // The transparent layer intercepts every press outside the menu (it is the
    // hit target while the menu is open, so the content panel underneath never
    // sees these events). The open menu box itself, captured for the check in
    // RepositionFromOutside.
    private Panel? _menuPanel;

    // These two consume presses/clicks on the menu without requesting a
    // render: a rebuild replaces the TextInput instance and only carries over
    // the caret and selection (not the in-flight drag/modifier state), so any
    // render here would break mouse selection and Shift+arrow / Ctrl+A while
    // editing the inline name input. Returning false keeps the event handled
    // (the click dispatch still stops at the menu) without that rebuild.
    private bool ConsumeContextPointer(UiPointerEvent e) => false;

    private bool ConsumeContextClick(UiPointerEvent e) => false;

    /// <summary>
    /// Right-click on the overlay while a menu is open reopens the empty-area
    /// menu at the new press position, so the menu follows a new right-click
    /// location instead of staying where it was. A press inside the menu box
    /// is owned by the menu (its pointer handler already ran) and is left
    /// alone. Left-clicks return false so the click still reaches
    /// <see cref="CloseFromOutside"/>.
    /// </summary>
    private bool RepositionFromOutside(UiPointerEvent e)
    {
        if (e.Button != 1) return false;
        if (EditorContentState.ContextMenu is null) return false;
        if (_menuPanel is not null &&
            e.X >= _menuPanel.Layout.X && e.X <= _menuPanel.Layout.Right &&
            e.Y >= _menuPanel.Layout.Y && e.Y <= _menuPanel.Layout.Bottom)
            return false;
        EditorContentState.OpenEmptyContextMenu(EditorContentState.CurrentFolder, e.X, e.Y);
        return true;
    }

    private void CloseFromOutside(UiPointerEvent e)
    {
        if (e.Button == 0)
            EditorContentState.CloseContextMenu();
    }

    private void OpenContextFolder()
    {
        if (EditorContentState.ContextMenu is { } menu)
            EditorContentState.NavigateTo(menu.Path);
    }

    private void OpenContextFile()
    {
        if (EditorContentState.ContextMenu is { } menu)
            EditorContentState.RequestAction(EditorContentState.ActionKind.Open, menu.Path);
    }

    private void RevealContextPath()
    {
        if (EditorContentState.ContextMenu is { } menu)
            EditorContentState.RequestAction(EditorContentState.ActionKind.Reveal, menu.Path);
    }

    private void BeginRename()
    {
        if (EditorContentState.ContextMenu is not { } menu) return;
        _renamePath = menu.Path;
        _deletePath = null;
        _renameValue = ContextName(menu);
    }

    private void OnRenameInput(string value) => _renameValue = value;

    /// <summary>
    /// Handles Enter (confirm) and Escape (cancel) on the rename input. Other
    /// keys return false so the input's own selection handling (Shift+arrow,
    /// Ctrl+A, ...) is not interrupted by a rebuild between key events.
    /// </summary>
    private bool OnRenameKeyDown(KeyEvent e)
    {
        if (!e.IsDown) return false;
        if (e.KeyCode == 13) { ConfirmRename(); return true; }
        if (e.KeyCode == 27) { CancelInlineAction(); return true; }
        return false;
    }

    private void ConfirmRename()
    {
        if (_renamePath is not null)
            EditorContentState.RequestAction(EditorContentState.ActionKind.Rename, _renamePath, _renameValue);
        _renamePath = null;
    }

    private void BeginDelete()
    {
        if (EditorContentState.ContextMenu is not { } menu) return;
        _deletePath = menu.Path;
        _renamePath = null;
    }

    private void ConfirmDelete()
    {
        if (_deletePath is not null)
            EditorContentState.RequestAction(EditorContentState.ActionKind.Delete, _deletePath);
        _deletePath = null;
    }

    private void CancelInlineAction()
    {
        _renamePath = null;
        _deletePath = null;
        _createKind = null;
    }

    private string CreateLabel => _createKind == "file" ? "File" : "Folder";

    private void BeginCreateFolder()
    {
        if (EditorContentState.ContextMenu is not { } menu || !menu.IsEmpty) return;
        _createKind = "folder";
        _createValue = "New Folder";
        _renamePath = null;
        _deletePath = null;
    }

    private void BeginCreateFile()
    {
        if (EditorContentState.ContextMenu is not { } menu || !menu.IsEmpty) return;
        _createKind = "file";
        _createValue = "New File.txt";
        _renamePath = null;
        _deletePath = null;
    }

    private void OnCreateInput(string value) => _createValue = value;

    /// <summary>Enter confirms, Escape cancels; other keys pass through to the input's selection handling.</summary>
    private bool OnCreateKeyDown(KeyEvent e)
    {
        if (!e.IsDown) return false;
        if (e.KeyCode == 13) { ConfirmCreate(); return true; }
        if (e.KeyCode == 27) { CancelInlineAction(); return true; }
        return false;
    }

    private void ConfirmCreate()
    {
        if (EditorContentState.ContextMenu is { } menu && menu.IsEmpty)
        {
            var kind = _createKind == "file"
                ? EditorContentState.ActionKind.CreateFile
                : EditorContentState.ActionKind.CreateFolder;
            EditorContentState.RequestAction(kind, menu.Path, _createValue);
        }
        _createKind = null;
    }

    private void ImportPlaceholder() =>
        UiNotifications.Show("Content", "Import is not available yet.", "info");

    private void RefreshContent()
    {
        if (EditorContentState.ContextMenu is { } menu && menu.IsEmpty)
            EditorContentState.RequestAction(EditorContentState.ActionKind.Refresh, menu.Path);
    }
}

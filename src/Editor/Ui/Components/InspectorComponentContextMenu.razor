@inherits Crowbar.UI.RazorPanel
@namespace Crowbar.Editor.Ui.Components
@using Crowbar.UI

@* The component context menu opened by a right-click on an inspector component
   header (InspectorSection). It is mounted at the editor root (like
   ContentContextMenu) so its overlay escapes the dock pane: a left-click
   outside the menu closes it, a right-click outside reopens it over the
   component header it landed on (found by hit-testing under the overlay, the
   same way the content menu re-targets tiles). The actions target the
   component whose header was right-clicked. *@
@if (EditorInspectorState.ComponentContextMenu is { } menu)
{
    <div class="inspector-context-layer" @onmousedown="RepositionFromOutside" @onclick="CloseFromOutside">
        <div class="inspector-context-menu" @ref="_menuPanel" style="@ContextMenuStyle(menu)" @onmousedown="ConsumeContextPointer" @onclick="ConsumeContextClick">
            <div class="context-menu-title">@menu.ComponentId</div>
            <div class="context-menu-item" @onclick="ToggleComponent">@(EditorInspectorState.IsCollapsed(menu.ComponentId) ? "Expand Section" : "Collapse Section")</div>
            <div class="context-menu-separator"></div>
            <div class="context-menu-item context-menu-danger" @onclick="RemoveComponent">Remove Component</div>
        </div>
    </div>
}

@code {
    private const float MenuWidth = 210f;
    private const float MenuHeight = 130f;

    protected override int BuildHash() => EditorInspectorState.Version;

    // The first open builds this component while the editor root is still
    // being rebuilt, before the component is attached to a laid-out parent, so
    // the position cannot be clamped to the real window in that first build.
    // _repositionRequested hides that one frame at the press position;
    // _repositionPending asks for the follow-up render (see OnTreeBuilt) whose
    // build has the parent geometry and clamps the menu into view.
    private bool _repositionRequested;
    private bool _repositionPending;

    private string ContextMenuStyle(EditorInspectorState.ComponentContextMenuState menu)
    {
        var viewport = Parent?.Layout;
        if (viewport is not { Width: > 0, Height: > 0 })
        {
            // No geometry yet (first build): render hidden at the press
            // position and schedule one more render. If that render still
            // finds no geometry, fall back to a visible menu at the press
            // position instead of a hard-coded clamp.
            if (!_repositionRequested)
            {
                _repositionRequested = true;
                _repositionPending = true;
                return $"left: {menu.X - 8:0}px; top: {menu.Y - 34:0}px; opacity: 0;";
            }
            return $"left: {menu.X - 8:0}px; top: {menu.Y - 34:0}px;";
        }
        _repositionRequested = false;
        var x = Math.Clamp(menu.X - viewport.Value.X - 8, 4, Math.Max(4, viewport.Value.Width - MenuWidth - 4));
        var y = Math.Clamp(menu.Y - viewport.Value.Y - 34, 4, Math.Max(4, viewport.Value.Height - MenuHeight - 4));
        return $"left: {x:0}px; top: {y:0}px;";
    }

    protected override void OnTreeBuilt()
    {
        // StateHasChanged called during the build would be undone by MarkBuilt
        // (it records the hash and clears StateDirty afterwards), so the
        // follow-up render that re-clamps the first open is requested here,
        // after the build completed.
        if (_repositionPending)
        {
            _repositionPending = false;
            StateHasChanged();
        }
    }

    // The transparent layer intercepts every press outside the menu (it is the
    // hit target while the menu is open, so the inspector underneath never
    // sees these events). The open menu box itself, captured for the check in
    // RepositionFromOutside.
    private Panel? _menuPanel;

    // These two consume presses/clicks on the menu without requesting a
    // render: the overlay's handlers already ran, and the click on an item is
    // consumed by the item itself. Returning false keeps the event handled
    // without a rebuild.
    private bool ConsumeContextPointer(UiPointerEvent e) => false;

    private bool ConsumeContextClick(UiPointerEvent e) => false;

    /// <summary>
    /// Right-click on the overlay while a menu is open reopens the menu at the
    /// new press position, so the menu follows a new right-click location
    /// instead of staying where it was. A press inside the menu box is owned
    /// by the menu (its pointer handler already ran) and is left alone. A
    /// press on a component header under the overlay — the overlay is the hit
    /// target while a menu is open, so the header never receives the event
    /// itself — opens that component's menu. Any other right-click closes the
    /// menu. Left-clicks return false so the click still reaches
    /// <see cref="CloseFromOutside"/>.
    /// </summary>
    private bool RepositionFromOutside(UiPointerEvent e)
    {
        if (e.Button != 1) return false;
        if (EditorInspectorState.ComponentContextMenu is null) return false;
        if (_menuPanel is not null &&
            e.X >= _menuPanel.Layout.X && e.X <= _menuPanel.Layout.Right &&
            e.Y >= _menuPanel.Layout.Y && e.Y <= _menuPanel.Layout.Bottom)
            return false;

        // The overlay is the hit target while a menu is open, so the header
        // under the press never receives the event itself: resolve what it
        // landed on and open that component's menu. Headers are recognized by
        // class and data attribute — the runtime Razor compiler cannot
        // reference the editor component types from @code.
        var under = HitTestUnderneath(e.X, e.Y);
        for (var current = under; current is not null; current = current.Parent)
        {
            if (current.Classes.Contains("insp-section-head") &&
                current.Attributes.TryGetValue("data-component", out var componentId) && componentId.Length > 0)
            {
                EditorInspectorState.OpenComponentContextMenu(componentId, e.X, e.Y);
                return true;
            }
        }

        EditorInspectorState.CloseComponentContextMenu();
        return true;
    }

    /// <summary>
    /// Hit-tests the tree below the overlay at the given point: the overlay is
    /// the topmost hit target while a menu is open, so the search starts at
    /// the tree root and skips this overlay's subtree to find what a press
    /// actually landed on (a component header or plain empty space).
    /// </summary>
    private Panel? HitTestUnderneath(float x, float y)
    {
        Panel root = this;
        while (root.Parent is { } parent) root = parent;
        return root.HitTest(x, y, this);
    }

    private void CloseFromOutside(UiPointerEvent e)
    {
        if (e.Button == 0)
            EditorInspectorState.CloseComponentContextMenu();
    }

    private void ToggleComponent()
    {
        if (EditorInspectorState.ComponentContextMenu is { } menu)
            EditorInspectorState.Toggle(menu.ComponentId);
        EditorInspectorState.CloseComponentContextMenu();
    }

    private void RemoveComponent()
    {
        if (EditorInspectorState.ComponentContextMenu is { } menu)
            EditorInspectorState.RequestRemoveComponent(menu.ComponentId);
        EditorInspectorState.CloseComponentContextMenu();
    }
}

@inherits Crowbar.UI.RazorPanel
@namespace Crowbar.Editor.Ui.Components
@using Crowbar.UI
@using Microsoft.AspNetCore.Components

@* One tile of the content grid: a folder or a file. The thumbnail is the
   project's icon pack (Assets/Icons), tinted per kind. A single click selects
   the tile; a double click browses folders into themselves. The folder path
   travels as a [Parameter] (the event invoker cannot pass captured locals
   from an @onclick lambda). *@
<div class="asset-tile @(ListView ? "asset-tile-list" : "asset-tile-grid") asset-scale-@TileScale @(Selected ? "asset-selected" : "")"
     data-path="@Path" data-isfolder="@IsFolder"
     @onclick="OnClick" @ondblclick="OnDoubleClick" @onmousedown="OnPointerDown">
    <div class="asset-thumb thumb-@Kind">
        @if (Kind == "texture" && Path.Length > 0)
        {
            <img class="asset-thumb-image" src="@Path" />
        }
        else
        {
            <icon name="@IconName" />
        }
    </div>
    <div class="asset-name">@Name</div>
</div>

@code {
    [Parameter]
    public string Name { get; set; } = string.Empty;

    /// <summary>Thumbnail kind: model, texture, sound, shader, file or folder.</summary>
    [Parameter]
    public string Kind { get; set; } = "file";

    /// <summary>True for a folder tile: double-clicking browses into <see cref="Folder"/>.</summary>
    [Parameter]
    public bool IsFolder { get; set; }

    /// <summary>Content-relative folder path this tile browses into ("" for files).</summary>
    [Parameter]
    public string Folder { get; set; } = string.Empty;

    /// <summary>Logical content path used by context-menu actions.</summary>
    [Parameter]
    public string Path { get; set; } = string.Empty;

    [Parameter]
    public bool ListView { get; set; }

    /// <summary>True when this tile is the current content selection.</summary>
    [Parameter]
    public bool Selected { get; set; }

    /// <summary>Tile scale: 0 (compact), 1 (medium), or 2 (large).</summary>
    [Parameter]
    public int TileScale { get; set; } = 1;

    /// <summary>Project icon for the kind, from the Assets/Icons pack.</summary>
    private string IconName => IsFolder
        ? "Solar/folders/Bold/folder-2"
        : Kind switch
        {
            "model" => "cube",
            "texture" => "paint",
            "sound" => "audio",
            "shader" => "Solar/it/Bold/code",
            _ => "Solar/files/Bold/file"
        };

    protected override int BuildHash() => HashCode.Combine(Name, Kind, IsFolder, Folder, Path, ListView, Selected, TileScale);

    private void OnClick(UiPointerEvent e)
    {
        if (e.Button != 0) return;
        EditorContentState.Select(Path);
    }

    /// <summary>Double click: browse folders into themselves (files just stay selected).</summary>
    private void OnDoubleClick(UiPointerEvent e)
    {
        if (e.Button != 0 || !IsFolder || Folder.Length == 0) return;
        EditorContentState.NavigateTo(Folder);
    }

    private bool OnPointerDown(UiPointerEvent e)
    {
        if (e.Button != 1) return false;
        EditorContentState.OpenContextMenu(Path, IsFolder, e.X, e.Y);
        return true;
    }
}

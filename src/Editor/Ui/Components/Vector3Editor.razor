@inherits Crowbar.UI.PropertyEditorBase
@namespace Crowbar.Editor.Ui.Components
@using Crowbar.UI
@using System.Numerics
@attribute [EditorProperty(typeof(Vector3))]

<div class="vec-row" style="padding-left: @(Indent * 12)px">
    <div class="vec-label">@Name</div>
    <span class="vec-axis">X</span>
    <input class="vec-input" value="@DraftValue(XAxis, Axis(0))"
           @onfocus="OnFocusX" @oninput="OnInputX" @onblur="OnBlurX" @onkeydown="OnKeyX" />
    <span class="vec-axis">Y</span>
    <input class="vec-input" value="@DraftValue(YAxis, Axis(1))"
           @onfocus="OnFocusY" @oninput="OnInputY" @onblur="OnBlurY" @onkeydown="OnKeyY" />
    <span class="vec-axis">Z</span>
    <input class="vec-input" value="@DraftValue(ZAxis, Axis(2))"
           @onfocus="OnFocusZ" @oninput="OnInputZ" @onblur="OnBlurZ" @onkeydown="OnKeyZ" />
</div>

@code {
    private const string XAxis = "X";
    private const string YAxis = "Y";
    private const string ZAxis = "Z";

    private string Axis(int index)
    {
        var parts = Value.Split(',');
        return index < parts.Length ? parts[index].Trim() : string.Empty;
    }

    private void OnFocusX() => BeginEdit(XAxis, Axis(0));
    private void OnInputX(string t) => UpdateDraft(XAxis, t);
    private void OnFocusY() => BeginEdit(YAxis, Axis(1));
    private void OnInputY(string t) => UpdateDraft(YAxis, t);
    private void OnFocusZ() => BeginEdit(ZAxis, Axis(2));
    private void OnInputZ(string t) => UpdateDraft(ZAxis, t);

    private void OnBlurX() => Commit(XAxis);
    private void OnBlurY() => Commit(YAxis);
    private void OnBlurZ() => Commit(ZAxis);
    private bool OnKeyX(KeyEvent e) => OnKeyDown(e, XAxis);
    private bool OnKeyY(KeyEvent e) => OnKeyDown(e, YAxis);
    private bool OnKeyZ(KeyEvent e) => OnKeyDown(e, ZAxis);

    private void Commit(string axis)
    {
        if (!IsEditing(axis)) return;
        var parts = Value.Split(',').Select(part => part.Trim()).ToArray();
        while (parts.Length < 3) Array.Resize(ref parts, parts.Length + 1);
        parts[0] = DraftValue(XAxis, Axis(0));
        parts[1] = DraftValue(YAxis, Axis(1));
        parts[2] = DraftValue(ZAxis, Axis(2));
        var joined = string.Join(", ", parts);
        EndEdit(axis);
        EditorInspectorState.RequestEdit(Key, joined);
    }

    private bool OnKeyDown(KeyEvent e, string axis)
    {
        if (e.IsDown && e.KeyCode == 13) { Commit(axis); return true; }
        return false;
    }

    protected override int BuildHash() => HashCode.Combine(Name, Value, Key, Indent);
}
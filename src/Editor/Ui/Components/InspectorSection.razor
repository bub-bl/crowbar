@inherits Crowbar.UI.RazorPanel
@namespace Crowbar.Editor.Ui.Components
@using Crowbar.UI
@using Microsoft.AspNetCore.Components

@* Une section repliable de l'inspecteur (le transform ou un composant). Le
   pliage est conservé côté hôte via EditorInspectorState, donc il survit aux
   republishes à chaque frame. *@
<div class="insp-section">
    <div class="insp-section-head @(Open ? "" : "collapsed")" @onclick="OnToggle">
        <span class="caret">@(Open ? "▾" : "▸")</span>
        @if (!string.IsNullOrEmpty(Icon))
        {
            <icon name="@Icon" />
        }
        <span class="insp-section-title">@Title</span>
    </div>
    @if (Open)
    {
        <div class="insp-section-body">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Icon { get; set; } = string.Empty;

    [Parameter]
    public bool Open { get; set; } = true;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override int BuildHash() => HashCode.Combine(Id, Title, Icon, Open);

    private void OnToggle()
    {
        EditorInspectorState.Toggle(Id);
    }
}

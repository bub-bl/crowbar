@inherits Crowbar.UI.PropertyEditorBase
@namespace Crowbar.Editor.Ui.Components
@using Crowbar.UI
@using System.Numerics
@attribute [EditorProperty(typeof(Vector4))]

<div class="vec-row" style="padding-left: @(Indent * 12)px">
    <div class="vec-label">@Name</div>
    <span class="vec-axis">X</span>
    <ValueInput Value="@Axis(0)" Class="vec-input" OnCommit="OnCommitX" />
    <span class="vec-axis">Y</span>
    <ValueInput Value="@Axis(1)" Class="vec-input" OnCommit="OnCommitY" />
    <span class="vec-axis">Z</span>
    <ValueInput Value="@Axis(2)" Class="vec-input" OnCommit="OnCommitZ" />
    <span class="vec-axis">W</span>
    <ValueInput Value="@Axis(3)" Class="vec-input" OnCommit="OnCommitW" />
</div>

@code {
    private string Axis(int index)
    {
        var parts = Value.Split(',');
        return index < parts.Length ? parts[index].Trim() : string.Empty;
    }

    private void OnCommitX(string text) => Commit(0, text);
    private void OnCommitY(string text) => Commit(1, text);
    private void OnCommitZ(string text) => Commit(2, text);
    private void OnCommitW(string text) => Commit(3, text);

    private void Commit(int index, string text)
    {
        var parts = Value.Split(',').Select(part => part.Trim()).ToArray();
        while (parts.Length < 4) Array.Resize(ref parts, parts.Length + 1);
        parts[index] = text.Trim();
        EditorInspectorState.RequestEdit(Key, string.Join(", ", parts));
    }

    protected override int BuildHash() => HashCode.Combine(Name, Value, Key, Indent);
}
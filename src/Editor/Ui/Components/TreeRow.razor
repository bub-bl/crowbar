@inherits Crowbar.UI.RazorPanel
@namespace Crowbar.Editor.Ui.Components
@using Microsoft.AspNetCore.Components

<div class="tree-row @(Folder ? "tree-folder" : "") @(Selected ? "tree-selected" : "")" style="padding-left: @(Indent * 12 + 6)px">
    @if (Folder)
    {
        <span class="caret">@(Open ? "▾" : "▸")</span>
    }
    @if (!string.IsNullOrEmpty(Icon))
    {
        <icon name="@Icon" />
    }
    else if (Folder)
    {
        <icon name="@(Open ? "Solar/folders/Bold/folder-open" : "Solar/folders/Bold/folder-2")" />
    }
    <span class="tree-text">@Text</span>
</div>

@code {
    [Parameter]
    public string Text { get; set; } = string.Empty;

    /// <summary>Tree depth; indentation is 12px per level plus a 6px base.</summary>
    [Parameter]
    public int Indent { get; set; }

    [Parameter]
    public bool Folder { get; set; }

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public bool Selected { get; set; }

    /// <summary>Optional entity-type icon shown before the label. Folders without
    /// an explicit icon fall back to the folder glyph (open/closed).</summary>
    [Parameter]
    public string Icon { get; set; } = string.Empty;

    protected override int BuildHash() => HashCode.Combine(Text, Indent, Folder, Open, Selected, Icon);
}

@inherits Crowbar.UI.PropertyEditorBase
@namespace Crowbar.Editor.Ui.Components
@using Crowbar.UI
@attribute [EditorProperty(typeof(int))]
@attribute [EditorProperty(typeof(uint))]
@attribute [EditorProperty(typeof(long))]
@attribute [EditorProperty(typeof(ulong))]
@attribute [EditorProperty(typeof(short))]
@attribute [EditorProperty(typeof(ushort))]
@attribute [EditorProperty(typeof(byte))]
@attribute [EditorProperty(typeof(sbyte))]

<div class="prop-row" style="padding-left: @(Indent * 12)px">
    <div class="field-label">@Name</div>
    <input class="prop-input" value="@DraftValue(SelfInput, Value)"
           @onfocus="OnFocus" @oninput="OnInput" @onblur="OnBlur" @onkeydown="OnKeyDown" />
</div>

@code {
    private const string SelfInput = "_";

    private void OnFocus() => BeginEdit(SelfInput, Value);
    private void OnInput(string text) => UpdateDraft(SelfInput, text);
    private void OnBlur()
    {
        if (IsEditing(SelfInput)) EditorInspectorState.RequestEdit(Key, EndEdit(SelfInput));
    }
    private bool OnKeyDown(KeyEvent e)
    {
        if (e.IsDown && e.KeyCode == 13) { OnBlur(); return true; }
        return false;
    }

    protected override int BuildHash() => HashCode.Combine(Name, Value, Key, Indent);
}
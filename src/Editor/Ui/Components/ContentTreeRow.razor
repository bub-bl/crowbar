@inherits Crowbar.UI.RazorPanel
@namespace Crowbar.Editor.Ui.Components
@using Crowbar.UI
@using Microsoft.AspNetCore.Components

@* One row of the content folder tree (sidebar). The folder path travels as a
   [Parameter] (like TreeRow's Id and AddComponentItem's Name): the runtime
   event invoker cannot pass captured locals from an @onclick lambda, so the
   click handler reads its own parameter. The caret owns its own @onclick and
   only toggles the subtree (clicks fire on the deepest handler and stop), so
   folding never navigates away; clicking the row itself browses into the
   folder (which reveals it). Folders without children have no caret. *@
<div class="ctree-row @(Selected ? "ctree-selected" : "")" style="padding-left: @(Indent * 12 + 6)px"
     @onclick="OnClick" @onmousedown="OnPointerDown">
    @if (HasChildren)
    {
        <icon name="@(Open ? "Solar/arrows/Bold/alt-arrow-down" : "Solar/arrows/Bold/alt-arrow-right")" @onclick="Toggle" />
    }
    else
    {
        @* Leaves reserve the caret column so folder icons align across
           siblings: without it, a leaf's folder glyph sits where its
           parent's caret row puts its icon and reads as the same level. *@
        <div class="ctree-caret-slot"></div>
    }
    <icon name="Solar/folders/Bold/folder-2" />
    <span class="ctree-text">@Text</span>
</div>

@code {
    [Parameter]
    public string Text { get; set; } = string.Empty;

    /// <summary>Content-relative folder path this row browses into ("" = the content root).</summary>
    [Parameter]
    public string Folder { get; set; } = string.Empty;

    /// <summary>Tree depth; indentation is 12px per level plus a 6px base.</summary>
    [Parameter]
    public int Indent { get; set; }

    [Parameter]
    public bool HasChildren { get; set; }

    [Parameter]
    public bool Open { get; set; }

    /// <summary>True when this row is the folder currently browsed.</summary>
    [Parameter]
    public bool Selected { get; set; }

    protected override int BuildHash() => HashCode.Combine(Text, Folder, Indent, HasChildren, Open, Selected);

    /// <summary>Row click: browse into the folder (which reveals it in the tree).</summary>
    private void OnClick(UiPointerEvent e)
    {
        if (e.Button == 0)
            EditorContentState.NavigateTo(Folder);
    }

    private bool OnPointerDown(UiPointerEvent e)
    {
        if (e.Button != 1) return false;
        EditorContentState.OpenContextMenu(Folder, true, e.X, e.Y, "folder");
        return true;
    }

    /// <summary>Caret click: fold or unfold the subtree without navigating.</summary>
    private void Toggle() => EditorContentState.ToggleExpanded(Folder);
}

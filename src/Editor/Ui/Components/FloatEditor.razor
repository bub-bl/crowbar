@inherits Crowbar.UI.PropertyEditorBase
@namespace Crowbar.Editor.Ui.Components
@using Crowbar.UI
@attribute [EditorProperty(typeof(float))]
@attribute [EditorProperty(typeof(double))]

<div class="prop-row" style="padding-left: @(Indent * 12)px">
    <div class="field-label">@Name</div>
    <ValueInput Value="@Value" Class="prop-input" OnCommit="Commit" />
</div>

@code {
    private void Commit(string text) => EditorInspectorState.RequestEdit(Key, text);

    protected override int BuildHash() => HashCode.Combine(Name, Value, Key, Indent);
}
@page "/"
@page "/demo"
@inherits Crowbar.UI.RazorPanel
@using System
@using System.Text
@namespace Crowbar.Editor.Ui

@{ var pipelineLabel = new StringBuilder("Rendered by RazorPanel + Skia").ToString(); }

<div class="page">
    <div class="card">
        <div class="title">Crowbar Razor UI</div>
        <div class="subtitle">Razor + Yoga + Skia + WebGPU</div>

        <div class="separator"></div>

        <div class="row">
            <button class="action" @onclick="Increment">CLICKED @_count TIMES</button>
            <div class="status">SCREEN PANEL ACTIVE · RENDER @_renderCount</div>
        </div>
        <div class="row">
            <button class="action" @onclick="GoToFilters">FILTERS DEMO</button>
        </div>

        @if (_count > 0)
        {
            <div class="status">LAST ACTION REGISTERED</div>
        }

        <MyButton Value="Salut mec"></MyButton>
        <MyButton Value="Salut mec"></MyButton>

        <Card>
            <div class="field-label">INPUT FIELD (ChildContent)</div>
            <input class="field" value="@_name" @bind-value="_name"/>
            <div class="status">@_name</div>
        </Card>

        <Panel>
            <Header>
                <div class="panel-heading">PANEL — MULTIPLE RENDERFRAGMENTS</div>
            </Header>
            <Body>
                <div class="panel-line">Body fragment · @_name</div>
                <div class="panel-line">Header, Body and Footer are separate RenderFragment parameters</div>
            </Body>
            <Footer>
                <div class="panel-line panel-foot">FOOTER FRAGMENT</div>
            </Footer>
        </Panel>

        <div class="footer">@pipelineLabel</div>
    </div>

    <div class="scroll-demo">
        <div class="demo-title">SCROLL — overflow: auto</div>
        <div class="scroll-area">
            @for (var i = 1; i <= 24; i++)
            {
                <div class="scroll-line">Item @i — @_name</div>
            }
        </div>
        <div class="hint">Mouse wheel, arrow keys or drag the thumb</div>

        <div class="demo-title">CLIP — overflow: hidden</div>
        <div class="clip-demo">
            <div class="clip-wide">This row is wider than its container</div>
        </div>
        <div class="hint">Content past the edge is clipped</div>

        <div class="demo-title">TRANSFORMS — one demo per function</div>
        <div class="transform-grid">
            <div class="trow">
                <div class="tile"><div class="t-box t-translate"><div class="t-dot"></div></div><div class="t-label">translate(24px, 12px)</div></div>
                <div class="tile"><div class="t-box t-translate-x"><div class="t-dot"></div></div><div class="t-label">translateX(30px)</div></div>
                <div class="tile"><div class="t-box t-translate-y"><div class="t-dot"></div></div><div class="t-label">translateY(-14px)</div></div>
            </div>
            <div class="trow">
                <div class="tile"><div class="t-box t-scale"><div class="t-dot"></div></div><div class="t-label">scale(1.4)</div></div>
                <div class="tile"><div class="t-box t-scale-x"><div class="t-dot"></div></div><div class="t-label">scaleX(1.6)</div></div>
                <div class="tile"><div class="t-box t-scale-y"><div class="t-dot"></div></div><div class="t-label">scaleY(0.65)</div></div>
            </div>
            <div class="trow">
                <div class="tile"><div class="t-box t-rotate"><div class="t-dot"></div></div><div class="t-label">rotate(20deg)</div></div>
                <div class="tile"><div class="t-box t-skew"><div class="t-dot"></div></div><div class="t-label">skew(-18deg, 8deg)</div></div>
                <div class="tile"><div class="t-box t-skew-x"><div class="t-dot"></div></div><div class="t-label">skewX(-20deg)</div></div>
            </div>
            <div class="trow">
                <div class="tile"><div class="t-box t-skew-y"><div class="t-dot"></div></div><div class="t-label">skewY(12deg)</div></div>
                <div class="tile"><div class="t-box t-matrix"><div class="t-dot"></div></div><div class="t-label t-matrix-label">matrix(1.15,.12,-.08,1,10,8)</div></div>
                <div class="tile"><div class="t-box t-origin"><div class="t-dot"></div></div><div class="t-label">rotate · origin: 0% 0%</div></div>
            </div>
        </div>
    </div>
</div>

@code {

    private int _count;
    private string _name = "Type input here";
    private int _renderCount;

    protected override int BuildHash() => HashCode.Combine(_count, _name);

    protected override void OnAfterRender(bool firstRender)
    {
        _renderCount++;
    }

    private void Increment()
    {
        _count++;
    }

    private void GoToFilters() => NavigateTo("/filters");

}

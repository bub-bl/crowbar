@page "/editor"
@inherits Crowbar.UI.RazorPanel
@namespace Crowbar.Editor.Ui

<div class="editor">
    <TopBar />
    <ToolsPanel />
    <ExplorerPanel />
    <ViewportPanel />
    <InspectorPanel />
    <WorldPanel />
    <ContentPanel />
    <StatusBar />
    <Notifications />
</div>

@* No page-level time bucket: the periodic refresh is scoped to the StatusBar
   component, whose own time-bucketed BuildHash requests the re-render. The
   page itself only rebuilds on real state changes, so the whole tree is not
   re-cascaded and re-laid-out every 400 ms for a couple of changing numbers. *@

@page "/editor"
@inherits Crowbar.UI.RazorPanel
@namespace Crowbar.Editor.Ui

<div class="editor">
    <TopBar />
    <DockArea @key="dock-area" />
    <StatusBar />
    <Notifications />
</div>

@* Les panneaux (outils, explorateur, viewport, inspecteur, monde, contenu)
   sont désormais des éléments dockables gérés par le DockArea : onglets,
   drag & drop avec prévisualisation des zones, et redimensionnement par les
   poignées entre les groupes. La top bar et la status bar restent fixes. *@

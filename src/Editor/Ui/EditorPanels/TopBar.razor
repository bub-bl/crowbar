@inherits Crowbar.UI.RazorPanel
@namespace Crowbar.Editor.Ui.EditorPanels

<div class="logo">Crowbar</div>

<div class="tabs">
    <div class="tab @TabClass("jouer")" @onclick="TabJouer">JOUER</div>
    <div class="tab @TabClass("creer")" @onclick="TabCreer">CRÉER</div>
    <div class="tab @TabClass("developper")" @onclick="TabDevelopper">DÉVELOPPER</div>
</div>

<div class="topbar-tools">
    <div class="tb-btn tb-on" title="Sélection" tooltip="Outil de sélection"><icon name="Solar/ui/Bold/cursor" /></div>
    <div class="tb-btn" title="Translation" tooltip="Déplacer l'entité sélectionnée"><icon name="translate" /></div>
    <div class="tb-btn" title="Rotation" tooltip="Faire pivoter l'entité sélectionnée"><icon name="Solar/arrows/Bold/restart" /></div>
    <div class="tb-btn" title="Échelle" tooltip="Redimensionner l'entité sélectionnée"><icon name="Solar/arrows-action/Bold/maximize-square-2" /></div>
    <div class="tb-sep"></div>
    <div class="tb-btn" title="Snapping" tooltip="Activer l'aimantation"><icon name="Solar/ui/Bold/target" /></div>
    <div class="tb-btn" title="Grille" tooltip="Afficher la grille"><icon name="Solar/tools/Bold/three-squares" /></div>
</div>

<div class="tb-play" tooltip="Lancer le mode test (F5)">▶&#160;Tester&#160;(F5)</div>

<div class="tb-mode">Mode&#160;:&#160;Édition&#160;<span class="caret">▾</span></div>

<div class="tb-user">
    <div class="tb-btn" title="Paramètres" tooltip="Paramètres"><icon name="Solar/settings/Bold/settings" /></div>
    <div class="avatar">J</div>
    <div class="username">JohnDoe</div>
</div>

<div class="tb-window">
    <div class="tb-win-btn">—</div>
    <div class="tb-win-btn">▢</div>
    <div class="tb-win-btn tb-close">✕</div>
</div>

@code {
    private string _tab = "creer";

    protected override int BuildHash() => HashCode.Combine(_tab);

    private void TabJouer() => _tab = "jouer";
    private void TabCreer() => _tab = "creer";
    private void TabDevelopper() => _tab = "developper";

    private string TabClass(string tab) => _tab == tab ? "tab-active" : "";
}

@inherits Crowbar.UI.RazorPanel
@namespace Crowbar.Editor.Ui.EditorPanels
@using Crowbar.UI

@* Publishes the custom title bar geometry (window buttons, interactive
   regions, height) after each layout, so the native window can answer
   WM_NCHITTEST and reproduce the native title bar behavior (drag,
   minimize/maximize/close, snap layouts). The block below republishes the
   refs of the previous render when a rebuild is needed, then OnLayoutChanged
   republishes the rects of the new tree as soon as Yoga has measured them.
   Thus hit-testing does not depend on a one-frame delay. *@
@{
    PublishChrome();
}

<div class="logo @(ChromeState.IsActive ? "" : "tb-inactive")">@DocumentLabel()</div>

<div class="tabs @(ChromeState.IsActive ? "" : "tb-inactive")" @ref="_tabs">
    <div class="tab @TabClass("play")" @onclick="TabPlay">PLAY</div>
    <div class="tab @TabClass("create")" @onclick="TabCreate">CREATE</div>
    <div class="tab @TabClass("develop")" @onclick="TabDevelop">DEVELOP</div>
</div>

<div class="topbar-tools @(ChromeState.IsActive ? "" : "tb-inactive")" @ref="_tools">
    <div class="tb-btn" title="Open a game project" tooltip="Open a game project (.crproj file)&#160;:&#160;@ProjectPathLabel()" @onclick="RequestOpenProject"><icon name="Solar/folders/Bold/folder-open" /></div>
    <div class="tb-btn" title="Notifications" tooltip="Show/hide the notifications window (Ctrl+Shift+N)" @onclick="RequestToggleNotifications"><icon name="Solar/notifications/Bold/bell" /></div>
    <div class="tb-sep"></div>
    <div class="tb-btn tb-on" title="Select" tooltip="Selection tool"><icon name="Solar/ui/Bold/cursor" /></div>
    <div class="tb-btn" title="Move" tooltip="Move the selected entity"><icon name="translate" /></div>
    <div class="tb-btn" title="Rotate" tooltip="Rotate the selected entity"><icon name="Solar/arrows/Bold/restart" /></div>
    <div class="tb-btn" title="Scale" tooltip="Resize the selected entity"><icon name="Solar/arrows-action/Bold/maximize-square-2" /></div>
    <div class="tb-sep"></div>
    <div class="tb-btn" title="Snapping" tooltip="Enable snapping"><icon name="Solar/ui/Bold/target" /></div>
    <div class="tb-btn" title="Grid" tooltip="Show the grid"><icon name="Solar/tools/Bold/three-squares" /></div>
    <div class="tb-btn tb-local" title="Local" tooltip="Use local axes"><icon name="Solar/it/Bold/translation" /></div>
    <div class="tb-sep"></div>
    <div class="tb-btn @UndoClass" title="Undo" tooltip="Undo (Ctrl+Z)&#160;:&#160;@EditorUndoState.UndoLabel" @onclick="RequestUndo"><icon name="Solar/arrows/Bold/round-arrow-left" /></div>
    <div class="tb-btn @RedoClass" title="Redo" tooltip="Redo (Ctrl+Shift+Z)&#160;:&#160;@EditorUndoState.RedoLabel" @onclick="RequestRedo"><icon name="Solar/arrows/Bold/round-arrow-right" /></div>
</div>

<div class="tb-play @(ChromeState.IsActive ? "" : "tb-inactive")" @ref="_play" tooltip="Launch test mode (F5)"><icon name="Solar/video/Bold/play" />Test&#160;(F5)</div>

<div class="tb-mode @(ChromeState.IsActive ? "" : "tb-inactive")" @ref="_mode" tooltip="Switch mode"><icon name="Solar/it/Bold/code" />Mode&#160;:&#160;Edit&#160;<icon name="Solar/arrows/Bold/alt-arrow-down" /></div>

<div class="tb-user @(ChromeState.IsActive ? "" : "tb-inactive")" @ref="_user">
    <div class="tb-btn" title="Settings" tooltip="Settings"><icon name="Solar/settings/Bold/settings" /></div>
    <div class="avatar">J</div>
    <div class="username">JohnDoe</div>
</div>

@* The window buttons stay mounted even when the chrome is inactive
   (platform without a custom caption, or fullscreen): hidden via the
   .tb-window-hidden class (opacity 0, never display:none so their rects
   stay measured), their @ref keeps the publish cycle stable. They receive
   no @onclick: their zone answers WM_NCHITTEST
   (HTMINBUTTON/HTMAXBUTTON/HTCLOSE), then Win32WindowChrome explicitly
   performs the native action if the SDL procedure does not relay it. This
   preserves the snap layouts flyout when hovering Maximize. The hover state
   (resolved OS-side) drives the highlight here. *@
<div class="tb-window @(ChromeState.SupportsCustomChrome && !ChromeState.IsFullscreen ? "" : "tb-window-hidden")">
    <div class="tb-win-btn @(ChromeState.HoveredButton == WindowChromeButton.Minimize ? "hover" : "")" @ref="_minimize" title="Minimize"><span class="tb-win-glyph">&#xE921;</span></div>
    <div class="tb-win-btn @(ChromeState.HoveredButton == WindowChromeButton.Maximize ? "hover" : "")" @ref="_maximize" title="@(ChromeState.IsMaximized ? "Restore" : "Maximize")"><span class="tb-win-glyph">@(ChromeState.IsMaximized ? "\uE923" : "\uE922")</span></div>
    <div class="tb-win-btn tb-close @(ChromeState.HoveredButton == WindowChromeButton.Close ? "hover" : "")" @ref="_close" title="Close"><span class="tb-win-glyph">&#xE8BB;</span></div>
</div>

@code {
    private string _tab = "create";
    private bool _initialChromePublishRequested;
    private Panel? _minimize;
    private Panel? _maximize;
    private Panel? _close;
    private Panel? _tabs;
    private Panel? _tools;
    private Panel? _play;
    private Panel? _mode;
    private Panel? _user;

    protected override int BuildHash()
    {
        var chrome = ChromeState;
        return HashCode.Combine(
            HashCode.Combine(
                _tab,
                (int)chrome.HoveredButton,
                chrome.IsMaximized,
                chrome.IsActive,
                chrome.IsFullscreen,
                chrome.SupportsCustomChrome,
                EditorDocumentState.Version,
                EditorUndoState.Version),
            EditorProjectState.Version);
    }

    private void TabPlay() => _tab = "play";
    private void TabCreate() => _tab = "create";
    private void TabDevelop() => _tab = "develop";

    // Undo/redo buttons: enabled state comes from the host-published bridge
    // (EditorUndoState), the click only queues a request the host consumes next
    // frame — the history itself lives on the document, never in the panel.
    private string UndoClass => EditorUndoState.CanUndo ? "" : "tb-disabled";
    private string RedoClass => EditorUndoState.CanRedo ? "" : "tb-disabled";
    private void RequestUndo()
    {
        if (EditorUndoState.CanUndo)
            EditorUndoState.RequestUndo();
    }
    private void RequestRedo()
    {
        if (EditorUndoState.CanRedo)
            EditorUndoState.RequestRedo();
    }

    private string TabClass(string tab) => _tab == tab ? "tab-active" : "";

    /// <summary>Path of the current project, or a fallback label when the editor runs on the demo project.</summary>
    private string ProjectPathLabel() =>
        EditorProjectState.HasProject ? EditorProjectState.Path : "no project (demo)";

    private void RequestOpenProject() => EditorProjectState.RequestOpen();

    private void RequestToggleNotifications() => EditorNotificationWindowState.RequestToggle();

    /// <summary>Name of the open document (with a dot for unsaved changes), or the app name.</summary>
    private string DocumentLabel() =>
        EditorDocumentState.HasDocument
            ? EditorDocumentState.Title + (EditorDocumentState.IsDirty ? " ●" : "")
            : "Crowbar";

    /// <summary>
    /// Republishes the geometry after the first layout (the children's rects
    /// are only known once the layout has passed). OnTreeBuilt is called on
    /// every rebuild: the guard avoids a loop.
    /// </summary>
    protected override void OnTreeBuilt()
    {
        if (_initialChromePublishRequested) return;
        _initialChromePublishRequested = true;
        StateHasChanged();
    }

    // Unlike ordinary Razor components, the title bar's first resolved layout
    // is itself an external event: Win32 must receive the button rectangles as
    // soon as Yoga has measured them, without waiting for another Razor build.
    protected override bool NotifyInitialLayoutChanged => true;

    protected override void OnLayoutChanged() => PublishChrome();

    private void PublishChrome()
    {
        // During a taskbar restore Yoga can briefly report a zero/one-pixel
        // component rect. Keep the last valid native layout during that frame;
        // publishing null here would remove every caption hit region until a
        // later resize happened to rebuild the TopBar.
        if (Layout.Width <= 1 || Layout.Height <= 1)
            return;

        // Without a custom caption (non-Windows platforms) or in fullscreen, there
        // is nothing to move or resize: the native hit test handles everything
        // (or no longer exists).
        if (!ChromeState.SupportsCustomChrome || ChromeState.IsFullscreen)
        {
            PublishWindowChrome(null);
            return;
        }

        // The interactive regions stay inside the client area (clicks received
        // by the UI).
        var interactive = new List<UiRect>();
        AddRect(interactive, _tabs);
        AddRect(interactive, _tools);
        AddRect(interactive, _play);
        AddRect(interactive, _mode);
        AddRect(interactive, _user);

        PublishWindowChrome(new WindowChromeLayout(
            Layout.Height,
            RectOrEmpty(_minimize),
            RectOrEmpty(_maximize),
            RectOrEmpty(_close),
            interactive));
    }

    private static void AddRect(List<UiRect> list, Panel? panel)
    {
        if (panel is not null && panel.Layout.Width > 0 && panel.Layout.Height > 0)
            list.Add(panel.Layout);
    }

    private static UiRect RectOrEmpty(Panel? panel) =>
        panel is not null && panel.Layout.Width > 0 && panel.Layout.Height > 0 ? panel.Layout : default;
}

@inherits Crowbar.UI.RazorPanel
@namespace Crowbar.Editor.Ui.EditorPanels
@using Crowbar.UI

<div class="viewport-toolbar">
    <div class="vt-btn @ToolClass("translate")" title="Move" tooltip="Move (W)" @onclick="ToolTranslate"><icon name="translate" /></div>
    <div class="vt-btn @ToolClass("rotate")" title="Rotate" tooltip="Rotate (E)" @onclick="ToolRotate"><icon name="Solar/arrows/Bold/restart" /></div>
    <div class="vt-btn @ToolClass("scale")" title="Scale" tooltip="Scale (R)" @onclick="ToolScale"><icon name="Solar/arrows-action/Bold/maximize-square-2" /></div>
    <div class="vt-btn" title="Grid" tooltip="Show the grid (G)"><icon name="Solar/tools/Bold/three-squares" /></div>
    <div class="vt-btn" title="Light" tooltip="Add a light"><icon name="Solar/devices/Bold/lightbulb" /></div>
    <div class="vt-btn" title="Camera" tooltip="Add a camera"><icon name="Solar/video/Bold/camera" /></div>
    <div class="vt-sep"></div>
    <div class="vt-local" tooltip="Coordinate system"><span>Local</span><icon name="Solar/arrows/Bold/alt-arrow-down" /></div>
</div>

@code {
    // Rebuilds the toolbar when the active tool changes so the selected button
    // gets its highlight (mirrors the TopBar tab pattern).
    protected override int BuildHash() => GizmoToolState.Mode;

    private void ToolTranslate() => GizmoToolState.Mode = 0;
    private void ToolRotate() => GizmoToolState.Mode = 1;
    private void ToolScale() => GizmoToolState.Mode = 2;

    private string ToolClass(string tool) => GizmoToolState.Mode switch
    {
        0 when tool == "translate" => "vt-btn-active",
        1 when tool == "rotate" => "vt-btn-active",
        2 when tool == "scale" => "vt-btn-active",
        _ => ""
    };
}

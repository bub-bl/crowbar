@inherits Crowbar.UI.RazorPanel
@namespace Crowbar.Editor.Ui.EditorPanels
@using Crowbar.UI

<SearchBox Placeholder="Search..." />

@* The tree reflects the real world hierarchy: the rows are published every
   frame by the host (ExplorerTreeBuilder) from the levels, the entities and
   their transform attachments. Selection and folding are synchronized via
   EditorExplorerState. *@
<div class="tree">
    @foreach (var row in Rows)
    {
        <TreeRow Text="@row.Node.Name" Folder="@row.Node.IsFolder"
                 Open="@(!EditorExplorerState.IsCollapsed(row.Node.Id))"
                 Selected="@(EditorExplorerState.SelectionId == row.Node.Id)"
                 Indent="@row.Depth" Icon="@row.Node.Icon" Id="@row.Node.Id.ToString()" />
    }
</div>

@code {
    private readonly record struct Row(EditorExplorerState.TreeNode Node, int Depth);

    private int _rowsVersion = -1;
    private IReadOnlyList<Row> _rows = [];

    // Re-renders only when the host republishes the world hierarchy, the
    // selection changes, or a folder is collapsed.
    protected override int BuildHash() => EditorExplorerState.Version;

    /// <summary>Pre-order rows, minus the subtrees hidden under collapsed folders.</summary>
    private IReadOnlyList<Row> Rows
    {
        get
        {
            if (_rowsVersion == EditorExplorerState.Version) return _rows;
            _rows = BuildRows();
            _rowsVersion = EditorExplorerState.Version;
            return _rows;
        }
    }

    private List<Row> BuildRows()
    {
        var rows = new List<Row>();
        var depths = new Dictionary<Guid, int>();
        // Depths of the currently collapsed ancestor folders: while the pre-order
        // walk is inside one of them, the following rows are hidden.
        var collapsedDepths = new List<int>();
        foreach (var node in EditorExplorerState.Nodes)
        {
            var depth = node.ParentId is { } parentId && depths.TryGetValue(parentId, out var parentDepth)
                ? parentDepth + 1
                : 0;
            depths[node.Id] = depth;

            while (collapsedDepths.Count > 0 && collapsedDepths[^1] >= depth)
                collapsedDepths.RemoveAt(collapsedDepths.Count - 1);
            if (collapsedDepths.Count > 0)
                continue; // under a collapsed ancestor

            rows.Add(new Row(node, depth));
            if (node.IsFolder && EditorExplorerState.IsCollapsed(node.Id))
                collapsedDepths.Add(depth);
        }

        return rows;
    }
}

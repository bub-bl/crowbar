@inherits Crowbar.UI.RazorPanel
@namespace Crowbar.Editor.Ui.EditorPanels
@using Crowbar.UI

@* The inspector mirrors the entity selected in the hierarchy (or viewport).
   The host publishes the snapshot every frame via EditorInspectorState; each
   property carries the CLR type name of its value, and PropertyEditor resolves
   it to the concrete per-type editor component through the [EditorProperty]
   registry. Sections (transform + components) are collapsible and their state
   survives republishing. The "+ Add component" menu offers the component types
   the host publishes (engine + game project); a click queues a request the host
   applies to the selected entity. *@
<div class="insp-body">
    @if (!EditorInspectorState.HasSelection)
    {
        <div class="insp-empty">Select an entity to inspect it.</div>
    }
    else
    {
        <div class="insp-head">
            <div class="entity-name">@EditorInspectorState.EntityName</div>
        </div>

        @foreach (var section in EditorInspectorState.Sections)
        {
            <InspectorSection Id="@section.Id" Title="@section.Title" Icon="@section.Icon"
                              Open="@(!EditorInspectorState.IsCollapsed(section.Id))"
                              ShowEnabled="@section.IsComponent"
                              Enabled="@section.Enabled">
                @foreach (var property in section.Properties)
                {
                    <PropertyEditor TypeName="@property.TypeName" Name="@property.Name" Value="@property.Value"
                                    Key="@property.Key" Indent="@property.Indent" />
                }
            </InspectorSection>
        }

        <div class="add-component" @onclick="ToggleAddMenu">+ Add component</div>
        @if (EditorInspectorState.AddMenuOpen)
        {
            <div class="add-menu">
                @if (EditorInspectorState.AvailableComponentTypes.Count == 0)
                {
                    <div class="add-menu-empty">No component available</div>
                }
                @foreach (var name in EditorInspectorState.AvailableComponentTypes)
                {
                    <AddComponentItem Name="@name" />
                }
            </div>
        }
    }
</div>

@code {
    // Re-render when the host republishes the selection snapshot, the user
    // folds a section or toggles the Add Component menu (each bumps
    // EditorInspectorState.Version).
    protected override int BuildHash() => HashCode.Combine(
        EditorInspectorState.Version, EditorInspectorState.AddMenuOpen);

    private void ToggleAddMenu() => EditorInspectorState.ToggleAddMenu();
}

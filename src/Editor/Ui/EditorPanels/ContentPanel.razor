@inherits Crowbar.UI.RazorPanel
@namespace Crowbar.Editor.Ui.EditorPanels

<div class="content-tabs">
    <div class="content-tab @ContentTabClass("content")" @onclick="ShowContent">CONTENT</div>
    <div class="content-tab @ContentTabClass("output")" @onclick="ShowOutput">OUTPUT</div>
    <div class="content-tab @ContentTabClass("console")" @onclick="ShowConsole">CONSOLE</div>
</div>

<div class="content-toolbar">
    <div class="ct-btn">+ Import</div>
    <div class="ct-btn">New folder</div>
    <div class="breadcrumb">Assets&#160;<span class="crumb-sep">›</span>&#160;Structures</div>
    <SearchBox Placeholder="Search..." Small="true" />
    <div class="panel-x">×</div>
</div>

<div class="content-body">
    <div class="content-sidebar">
        <div class="cs-item cs-active">Content</div>
        <div class="cs-item">Assets › Structures</div>
        <div class="cs-item">Props</div>
        <div class="cs-item">Nature</div>
        <div class="cs-item">Materials</div>
        <div class="cs-item">Sounds</div>
        <div class="cs-item">Scripts</div>
        <div class="cs-item">Experiences</div>
        <div class="cs-item">Addons</div>
    </div>
    <div class="content-grid">
        <div class="grid-row-title">MODELS</div>
        <div class="asset-row">
            @foreach (var model in Models)
            {
                <AssetTile Name="@model" Kind="@ThumbKind(model)" />
            }
        </div>
        <div class="grid-row-title">MATERIALS</div>
        <div class="asset-row">
            @foreach (var material in Materials)
            {
                <AssetTile Name="@material" Kind="@ThumbKind(material)" Circle="true" />
            }
            <AssetTile Name="Import" Kind="wood" Circle="true" Import="true" />
        </div>
    </div>
</div>

@code {
    private static readonly string[] Models =
    [
        "wood_house.glb", "metal_hangar.glb", "water_tower.glb", "shed.glb", "wood_wall.glb",
        "wood_door.glb", "window.glb", "wood_stairs.glb", "wood_roof.glb"
    ];

    private static readonly string[] Materials =
    [
        "wood_wall.mat", "wood_roof.mat", "wood_floor.mat", "metal.mat", "concrete.mat", "wood_door.mat", "window_glass.mat"
    ];

    private string _contentTab = "content";

    protected override int BuildHash() => HashCode.Combine(_contentTab);

    private void ShowContent() => _contentTab = "content";
    private void ShowOutput() => _contentTab = "output";
    private void ShowConsole() => _contentTab = "console";

    private string ContentTabClass(string tab) => _contentTab == tab ? "content-tab-active" : "";

    private static string ThumbKind(string name) => name.Contains("metal", StringComparison.OrdinalIgnoreCase)
        ? "metal"
        : name.Contains("concrete", StringComparison.OrdinalIgnoreCase)
            ? "concrete"
            : name.Contains("glass", StringComparison.OrdinalIgnoreCase) || name.Contains("window", StringComparison.OrdinalIgnoreCase)
                ? "glass"
                : "wood";
}

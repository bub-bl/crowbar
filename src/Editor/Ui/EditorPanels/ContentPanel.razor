@inherits Crowbar.UI.RazorPanel
@namespace Crowbar.Editor.Ui.EditorPanels
@using Crowbar.UI

<div class="content-tabs">
    <div class="content-tab @ContentTabClass("content")" @onclick="ShowContent">CONTENT</div>
    <div class="content-tab @ContentTabClass("output")" @onclick="ShowOutput">OUTPUT</div>
    <div class="content-tab @ContentTabClass("console")" @onclick="ShowConsole">CONSOLE</div>
</div>

<div class="content-toolbar">
    <div class="ct-btn">+ Import</div>
    <div class="breadcrumb">Content@(EditorContentState.SelectedCategory.Length > 0 ? " › " + EditorContentState.SelectedCategory : "")</div>
    <SearchBox Placeholder="Search..." Small="true" />
    <div class="panel-x">×</div>
</div>

@* The grid mirrors the live project content: the host republishes the file
   list (EditorContentState) on startup, project switch and content changes.
   Selecting a category in the sidebar filters the rows. *@
<div class="content-body">
    <div class="content-sidebar">
        <ContentSidebarItem Text="Content" Category="" Active="@(EditorContentState.SelectedCategory.Length == 0)" />
        @foreach (var category in Categories)
        {
            <ContentSidebarItem Text="@category" Category="@category" Active="@(EditorContentState.SelectedCategory == category)" />
        }
    </div>
    <div class="content-grid">
        @if (EditorContentState.Entries.Count == 0)
        {
            <div class="grid-empty">No content — put assets in the project's Content/ folder.</div>
        }
        @foreach (var group in Groups)
        {
            <div class="grid-row-title">@GroupTitle(group.Category)</div>
            <div class="asset-row">
                @foreach (var entry in group.Entries)
                {
                    <AssetTile Name="@entry.Name" Kind="@entry.Kind" />
                }
            </div>
        }
    </div>
</div>

@code {
    private readonly record struct Group(string Category, IReadOnlyList<EditorContentState.Entry> Entries);

    private string _contentTab = "content";

    // Re-renders only when the host republishes the content snapshot, the
    // sidebar selection changes, or another tab is opened.
    protected override int BuildHash() => HashCode.Combine(_contentTab, EditorContentState.SelectedCategory, EditorContentState.Version);

    /// <summary>Content categories (top-level folders) for the sidebar.</summary>
    private IReadOnlyList<string> Categories => EditorContentState.Entries
        .Select(entry => entry.Category)
        .Where(category => category.Length > 0)
        .Distinct()
        .OrderBy(category => category, StringComparer.OrdinalIgnoreCase)
        .ToArray();

    /// <summary>Rows grouped by category, filtered by the selected one.</summary>
    private IReadOnlyList<Group> Groups
    {
        get
        {
            var selected = EditorContentState.SelectedCategory;
            return EditorContentState.Entries
                .Where(entry => selected.Length == 0 || entry.Category == selected)
                .GroupBy(entry => entry.Category)
                .OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase)
                .Select(group => new Group(group.Key, group.ToArray()))
                .ToArray();
        }
    }

    private void ShowContent() => _contentTab = "content";
    private void ShowOutput() => _contentTab = "output";
    private void ShowConsole() => _contentTab = "console";

    private string ContentTabClass(string tab) => _contentTab == tab ? "content-tab-active" : "";

    private static string GroupTitle(string category) => category.Length == 0 ? "ROOT" : category.ToUpperInvariant();
}

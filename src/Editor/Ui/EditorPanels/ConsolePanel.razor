@inherits Crowbar.UI.RazorPanel
@namespace Crowbar.Editor.Ui.EditorPanels
@using Crowbar.UI
@using G = Crowbar.Engine.Global
@using static Crowbar.Engine.GlobalNamespaces

<div class="console-toolbar">
    <div class="console-filter @FilterClass(G.LogLevel.Info)" @onclick="ToggleInfo">
        <icon name="Solar/essentional-ui/Bold/info-circle" />
        <span>Info</span>
    </div>
    <div class="console-filter @FilterClass(G.LogLevel.Warning)" @onclick="ToggleWarn">
        <icon name="Solar/notifications/Bold/bell" />
        <span>Warn</span>
    </div>
    <div class="console-filter @FilterClass(G.LogLevel.Error)" @onclick="ToggleError">
        <icon name="Solar/essentional-ui/Bold/danger-circle" />
        <span>Error</span>
    </div>
    <div class="console-spacer"></div>
    <div class="console-count">@VisibleCount / @AllCount</div>
    <div class="console-btn console-btn-test" @onclick="TriggerTestError" tooltip="Trigger a test error">Test Error</div>
    <div class="console-btn" @onclick="ClearConsole" tooltip="Clear console">Clear</div>
</div>

<div data-codex-ref="entriesContainer" class="console-entries">
    @foreach (var entry in VisibleEntries)
    {
        <ConsoleLine Message="@entry.Message" Level="@entry.Level.ToString()" Timestamp="@entry.Timestamp.ToString("HH:mm:ss")" StackTrace="@entry.StackTrace" />
    }
</div>

<div class="console-input-line">
    <span class="console-prompt">&gt;</span>
    <input class="console-input" placeholder="Command..." @oninput="OnCommandInput" @onkeydown="OnCommandKey" value="@_commandText" />
</div>

@code {
    private readonly List<G.LogEntry> _entries = new(128);
    private bool _showInfo = true;
    private bool _showWarn = true;
    private bool _showError = true;
    private string _commandText = string.Empty;
    private bool _scrollToBottomPending;
    private float _savedScrollY = -1;
    private const int MaxEntries = 1000;

    private Panel? _entriesRef;

    protected override void OnInitialized()
    {
        foreach (var entry in Log.Entries)
            AppendEntry(entry);
        _scrollToBottomPending = true;
        Log.EntryAdded += OnEntryAdded;
    }

    protected override void OnTreeBuilt()
    {
        if (_entriesRef is not null)
        {
            if (_scrollToBottomPending)
            {
                // MaxScrollY is still 0 from the fresh layout pass, so
                // ScrollTo would clamp to 0. ScrollToUnclamped bypasses
                // clamping; the next layout pass recalibrates MaxScrollY.
                _entriesRef.ScrollToUnclamped(0, float.MaxValue);
                _scrollToBottomPending = false;
            }
            else if (_savedScrollY >= 0)
            {
                _entriesRef.ScrollToUnclamped(0, _savedScrollY);
                _savedScrollY = -1;
            }
        }
    }

    private void OnEntryAdded(G.LogEntry entry)
    {
        // Save current scroll before the rebuild destroys the container.
        _savedScrollY = _entriesRef?.ScrollY ?? -1;

        // Auto-follow new entries only when the user is already at the bottom.
        if (_entriesRef is not null &&
            _entriesRef.MaxScrollY > 0 &&
            _entriesRef.ScrollY >= _entriesRef.MaxScrollY - 20f)
        {
            _scrollToBottomPending = true;
        }

        AppendEntry(entry);
        StateHasChanged();
    }

    private void AppendEntry(G.LogEntry entry)
    {
        _entries.Add(entry);
        while (_entries.Count > MaxEntries)
            _entries.RemoveAt(0);
    }

    private IReadOnlyList<G.LogEntry> VisibleEntries
    {
        get
        {
            return _entries.Where(e => e.Level switch
            {
                G.LogLevel.Info => _showInfo,
                G.LogLevel.Warning => _showWarn,
                G.LogLevel.Error => _showError,
                _ => true
            }).ToArray();
        }
    }

    private int AllCount => _entries.Count;
    private int VisibleCount => VisibleEntries.Count;

    private void ToggleInfo() => _showInfo = !_showInfo;
    private void ToggleWarn() => _showWarn = !_showWarn;
    private void ToggleError() => _showError = !_showError;

    private string FilterClass(G.LogLevel level) => level switch
    {
        G.LogLevel.Info => _showInfo ? "console-filter-active" : string.Empty,
        G.LogLevel.Warning => _showWarn ? "console-filter-active" : string.Empty,
        G.LogLevel.Error => _showError ? "console-filter-active" : string.Empty,
        _ => string.Empty
    };

    private void TriggerTestError()
    {
        try
        {
            throw new InvalidOperationException("This is a test error to verify stack trace rendering in the console.");
        }
        catch (Exception ex)
        {
            Log.Error("Test error triggered from console toolbar.", ex);
        }
    }

    private void ClearConsole()
    {
        _entries.Clear();
        Log.Clear();
    }

    private void OnCommandInput(string value)
    {
        _commandText = value;
    }

    private bool OnCommandKey(KeyEvent e)
    {
        if (e.KeyCode != 0x0D) // Enter
            return false;
        var command = _commandText.Trim();
        if (command.Length > 0)
        {
            Log.Info($"> {command}");
            G.ConCmdRegistry.Execute(command);
            _commandText = string.Empty;
        }
        return true;
    }

    protected override int BuildHash()
    {
        var hash = new HashCode();
        hash.Add(_entries.Count);
        hash.Add(_showInfo);
        hash.Add(_showWarn);
        hash.Add(_showError);
        hash.Add(_commandText);
        return hash.ToHashCode();
    }
}
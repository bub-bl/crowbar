@inherits Crowbar.UI.RazorPanel
@namespace Crowbar.Editor.Ui.EditorPanels
@using Crowbar.UI
@using Microsoft.AspNetCore.Components

<div class="console-line @LevelClass" @onclick="ToggleExpand">
    <div class="console-row">
        <span class="console-time">@Timestamp</span>
        <span class="console-level">@LevelLabel</span>
        <span class="console-message">@Message</span>
        @if (HasExpandable)
        {
            @if (_expanded)
            {
                <span class="console-expand-icon">
                    <icon name="Solar/arrows/Bold/alt-arrow-down" />
                </span>
            }
            else
            {
                <span class="console-expand-icon">
                    <icon name="Solar/arrows/Bold/alt-arrow-right" />
                </span>
            }
        }
    </div>
    @if (_expanded && DetailsLines.Length > 0)
    {
        <div class="console-details">
            @foreach (var line in DetailsLines)
            {
                <div class="console-detail-line">@line</div>
            }
        </div>
    }
    @if (_expanded && StackTrace.Length > 0)
    {
        <div class="console-stack">@StackTrace</div>
    }
</div>

@code {
    [Parameter]
    public string Message { get; set; } = string.Empty;

    /// <summary>"Info", "Warning", or "Error".</summary>
    [Parameter]
    public string Level { get; set; } = "Info";

    [Parameter]
    public string Timestamp { get; set; } = string.Empty;

    /// <summary>Sub-lines (e.g. a command list) shown below the message when expanded, newline-separated.</summary>
    [Parameter]
    public string Details { get; set; } = string.Empty;

    [Parameter]
    public string StackTrace { get; set; } = string.Empty;

    private bool _expanded;

    private bool HasExpandable => Details.Length > 0 || StackTrace.Length > 0;

    /// <summary>Each sub-line rendered on its own row, so a command list stays one command per line.</summary>
    private string[] DetailsLines => Details.Length == 0 ? [] : Details.Split('\n');

    private string LevelClass => Level switch
    {
        "Warning" => "console-warn",
        "Error" => "console-error",
        _ => "console-info"
    };

    private string LevelLabel => Level switch
    {
        "Warning" => "Warn",
        _ => Level
    };

    private bool ToggleExpand(UiPointerEvent e)
    {
        if (e.Button != 0)
            return false;
        if (!HasExpandable)
            return false;
        _expanded = !_expanded;
        // Return false: the child ConsoleLine is rebuilt independently next
        // frame (BuildHash changed because _expanded is in it), but the parent
        // ConsolePanel is not invalidated, so the entries container and its
        // scroll position survive untouched.
        return false;
    }

    protected override int BuildHash()
    {
        var hash = new HashCode();
        hash.Add(Message);
        hash.Add(Level);
        hash.Add(Timestamp);
        hash.Add(Details);
        hash.Add(StackTrace);
        hash.Add(_expanded);
        return hash.ToHashCode();
    }
}
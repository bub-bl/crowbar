@inherits Crowbar.UI.RazorPanel
@namespace Crowbar.Editor.Ui.EditorPanels
@using Crowbar.UI
@using Microsoft.AspNetCore.Components

<div class="console-line @LevelClass" @onclick="ToggleExpand">
    <div class="console-row">
        <span class="console-time">@Timestamp</span>
        <span class="console-level">@LevelLabel</span>
        <span class="console-message">@Message</span>
        @if (HasExpandable)
        {
            @if (IsExpanded)
            {
                <span class="console-expand-icon">
                    <icon name="Solar/arrows/Bold/alt-arrow-down" />
                </span>
            }
            else
            {
                <span class="console-expand-icon">
                    <icon name="Solar/arrows/Bold/alt-arrow-right" />
                </span>
            }
        }
    </div>
    @if (IsExpanded && DetailsLines.Length > 0)
    {
        <div class="console-details">
            @foreach (var line in DetailsLines)
            {
                <div class="console-detail-line">@line</div>
            }
        </div>
    }
    @if (IsExpanded && StackTraceLines.Length > 0)
    {
        <div class="console-stack">
            @foreach (var line in StackTraceLines)
            {
                <div class="console-stack-line">@line</div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public string Message { get; set; } = string.Empty;

    /// <summary>"Info", "Warning", or "Error".</summary>
    [Parameter]
    public string Level { get; set; } = "Info";

    [Parameter]
    public string Timestamp { get; set; } = string.Empty;

    /// <summary>Sub-lines (e.g. a command list) shown below the message when expanded, separated by U+2028.</summary>
    [Parameter]
    public string Details { get; set; } = string.Empty;

    [Parameter]
    public string StackTrace { get; set; } = string.Empty;

    /// <summary>User override for expansion. Null follows the default: entries with sub-lines (Details) are expanded, plain lines and stack-trace-only errors are collapsed.</summary>
    private bool? _expandedOverride;

    private bool IsExpanded => _expandedOverride ?? Details.Length > 0;

    private bool HasExpandable => Details.Length > 0 || StackTrace.Length > 0;

    /// <summary>Each sub-line rendered on its own row, so a command list stays one command per line. Lines are separated by U+2028 (see ConsolePanel.LineSeparator) because newlines cannot survive Razor attribute parsing.</summary>
    private string[] DetailsLines => Details.Length == 0 ? [] : Details.Split('\u2028');

    /// <summary>Each stack-trace line rendered on its own row; lines are separated by U+2028.</summary>
    private string[] StackTraceLines => StackTrace.Length == 0 ? [] : StackTrace.Split('\u2028');

    private string LevelClass => Level switch
    {
        "Warning" => "console-warn",
        "Error" => "console-error",
        _ => "console-info"
    };

    private string LevelLabel => Level switch
    {
        "Warning" => "Warn",
        _ => Level
    };

    private bool ToggleExpand(UiPointerEvent e)
    {
        if (e.Button != 0)
            return false;
        if (!HasExpandable)
            return false;
        _expandedOverride = !IsExpanded;
        // Return false: the child ConsoleLine is rebuilt independently next
        // frame (BuildHash changed because IsExpanded is in it), but the
        // parent ConsolePanel is not invalidated, so the entries container
        // and its scroll position survive untouched.
        return false;
    }

    protected override int BuildHash()
    {
        var hash = new HashCode();
        hash.Add(Message);
        hash.Add(Level);
        hash.Add(Timestamp);
        hash.Add(Details);
        hash.Add(StackTrace);
        hash.Add(IsExpanded);
        return hash.ToHashCode();
    }
}
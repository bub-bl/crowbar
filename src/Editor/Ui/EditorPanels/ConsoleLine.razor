@inherits Crowbar.UI.RazorPanel
@namespace Crowbar.Editor.Ui.EditorPanels
@using Crowbar.UI
@using Microsoft.AspNetCore.Components

@* One line in the console log. Expand/contract toggles a CSS class on the root
   via AddClass/RemoveClass instead of relying on template re-evaluation, so the
   parent StateHasChanged cascade (and scroll reset) is avoided. *@
<div class="console-line @LevelClass">
    <div class="console-row">
        <span class="console-time">@Timestamp</span>
        <span class="console-level">@LevelLabel</span>
        <span class="console-message">@Message</span>
        <span class="console-expand-icon console-expand-collapsed">▶</span>
        <span class="console-expand-icon console-expand-expanded">▼</span>
    </div>
    <div class="console-stack">@StackTrace</div>
</div>

@code {
    [Parameter]
    public string Message { get; set; } = string.Empty;

    /// <summary>"Info", "Warning", or "Error".</summary>
    [Parameter]
    public string Level { get; set; } = "Info";

    [Parameter]
    public string Timestamp { get; set; } = string.Empty;

    [Parameter]
    public string StackTrace { get; set; } = string.Empty;

    private bool _expanded;
    private const string ExpandedClass = "console-line-expanded";

    private string LevelClass => Level switch
    {
        "Warning" => "console-warn",
        "Error" => "console-error",
        _ => "console-info"
    };

    private string LevelLabel => Level switch
    {
        "Warning" => "Warn",
        _ => Level
    };

    /// <summary>
    /// Toggles the expanded CSS class directly on the panel root. Returns
    /// false so the Razor event invoker skips StateHasChanged — the CSS
    /// class change via MarkStyleDirty is enough; a full parent re-render
    /// would reset the entries container scroll position.
    /// </summary>
    private bool ToggleExpand(UiPointerEvent e)
    {
        if (e.Button != 0)
            return false;
        _expanded = !_expanded;
        if (_expanded)
            AddClass(ExpandedClass);
        else
            RemoveClass(ExpandedClass);
        return false;
    }

    protected override int BuildHash()
    {
        var hash = new HashCode();
        hash.Add(Message);
        hash.Add(Level);
        hash.Add(Timestamp);
        hash.Add(StackTrace);
        hash.Add(_expanded);
        return hash.ToHashCode();
    }
}
@inherits Crowbar.UI.RazorPanel
@namespace Crowbar.Editor.Ui.EditorPanels
@using Crowbar.UI
@using Microsoft.AspNetCore.Components

@* One line in the console log. Parameters are plain strings because the Razor
   engine passes attributes as strings (Convert.ChangeType handles bool and int
   but not enums in this runtime). *@
<div class="console-line @LevelClass" @onclick="ToggleExpand">
    <div class="console-row">
        <span class="console-time">@Timestamp</span>
        <span class="console-level">@LevelLabel</span>
        <span class="console-message">@Message</span>
        @if (_hasDetails)
        {
            <span class="console-expand-icon">@(_expanded ? "▼" : "▶")</span>
        }
    </div>
    @if (_expanded && _hasDetails)
    {
        <div class="console-stack">@StackTrace</div>
    }
</div>

@code {
    [Parameter]
    public string Message { get; set; } = string.Empty;

    /// <summary>"Info", "Warning", or "Error".</summary>
    [Parameter]
    public string Level { get; set; } = "Info";

    [Parameter]
    public string Timestamp { get; set; } = string.Empty;

    [Parameter]
    public string StackTrace { get; set; } = string.Empty;

    private bool _expanded;
    private bool _hasDetails => StackTrace.Length > 0;

    private string LevelClass => Level switch
    {
        "Warning" => "console-warn",
        "Error" => "console-error",
        _ => "console-info"
    };

    private string LevelLabel => Level switch
    {
        "Warning" => "Warn",
        _ => Level
    };

    private void ToggleExpand()
    {
        if (!_hasDetails)
            return;
        _expanded = !_expanded;
    }

    protected override int BuildHash()
    {
        var hash = new HashCode();
        hash.Add(Message);
        hash.Add(Level);
        hash.Add(Timestamp);
        hash.Add(StackTrace);
        hash.Add(_expanded);
        return hash.ToHashCode();
    }
}
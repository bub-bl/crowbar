@inherits Crowbar.UI.RazorPanel
@namespace Crowbar.Editor.Ui.EditorPanels
@using Crowbar.UI

<div class="status-item">Mode&#160;:&#160;Edit</div>
<div class="status-spacer"></div>
<div class="status-item">FPS:&#160;@((int)UiDiagnostics.Fps)</div>
<div class="status-sep"></div>
<div class="status-item">Memory:&#160;@UsedMemory&#160;/&#160;@TotalMemory</div>
<div class="status-sep"></div>
<div class="status-item">Ping:&#160;@((int)UiDiagnostics.PingMs)&#160;ms</div>
@foreach (var entry in UiDiagnostics.StatusBarEntries)
{
    <div class="status-sep"></div>
    <div class="status-item">@entry.Label:&#160;@entry.Value</div>
}

@code {
    // The periodic refresh lives here, not on the page: this time-bucketed
    // hash is the only thing that asks the tree to re-render a few times per
    // second, so the live stats refresh without the page rebuilding on a
    // global timer (see UiSystem.RenderRazorIfNeeded).
    protected override int BuildHash() => Environment.TickCount / 400;

    private string UsedMemory => UiDiagnostics.FormatMemory(UiDiagnostics.UsedMemoryBytes);
    private string TotalMemory => UiDiagnostics.FormatMemory(UiDiagnostics.TotalMemoryBytes);
}
